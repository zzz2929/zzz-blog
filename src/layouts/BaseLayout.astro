---
import { ClientRouter } from "astro:transitions";
import { AnimatedBackground } from "@/components/react/AnimatedBackground";
import MiniPlayer from "@/components/astro/MiniPlayer.astro";
import Analytics from "@/components/astro/Analytics.astro";
import { getLocaleFromURL } from "@/i18n";
import { siteConfig } from "@/config/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** 关闭 View Transitions(音乐页内联大脚本,整页重载最稳) */
  transition?: boolean;
}

const locale = getLocaleFromURL(Astro.url.pathname);
const {
  title = siteConfig.title,
  description = siteConfig.description[locale],
  image,
  transition = true,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;
const isMusicPage =
  Astro.url.pathname === "/music/" || Astro.url.pathname === "/music";
// 首屏关键资源域（来自 src/config/site.ts 的 hero.randomImageApi / imageBedHost）
const heroImageOrigin = new URL(siteConfig.hero.randomImageApi).origin;

// hreflang 三语互指（src/config/site.ts → features.i18n）：
// 当前路径剥掉语言前缀后，为每个语言生成对应 URL
const i18nCfg = siteConfig.features.i18n;
const strippedPath = Astro.url.pathname.replace(
  new RegExp(`^/(${i18nCfg.locales.filter((l) => l !== i18nCfg.defaultLocale).join("|")})(?=/|$)`),
  "",
);
const hreflangEntries = i18nCfg.enable
  ? [
      ...i18nCfg.locales.map((l) => ({
        hreflang: l,
        href: new URL(
          (l === i18nCfg.defaultLocale ? "" : `/${l}`) + (strippedPath === "/" ? "/" : strippedPath),
          Astro.site,
        ).toString(),
      })),
      {
        hreflang: "x-default",
        href: new URL(strippedPath === "/" ? "/" : strippedPath, Astro.site).toString(),
      },
    ]
  : [];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta name="generator" content={Astro.generator} />
    {transition && <ClientRouter />}

    <!-- Perf: 提前与首屏关键资源域建连（LCP 随机图 / 图床图片）；
         统计与计数器属低优先级请求，仅做 DNS 预解析 -->
    <link rel="preconnect" href={heroImageOrigin} />
    <link rel="preconnect" href={`https://${siteConfig.imageBedHost}`} />
    <link rel="dns-prefetch" href="https://events.vercount.one" />
    <link rel="dns-prefetch" href="https://hm.baidu.com" />

    <!-- SEO -->
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {hreflangEntries.map((entry) => (
      <link rel="alternate" hreflang={entry.hreflang} href={entry.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteConfig.title} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}

    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    {
      image && (
        <meta name="twitter:image" content={new URL(image, Astro.site)} />
      )
    }

    <!-- Dark mode inline script (must run before body to avoid FOUC) -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
      // View Transitions 换页后 html 属性会被替换,重新应用暗色模式
      document.addEventListener("astro:after-swap", () => {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        document.documentElement.classList.toggle(
          "dark",
          stored === "dark" || (!stored && prefersDark),
        );
      });
    </script>
    <Analytics />
    {!import.meta.env.DEV && (
      <script>
        // PWA Service Worker 注册(构建产物含 sw.js;dev 下无 SW,静默跳过)
        if ("serviceWorker" in navigator) {
          import("virtual:pwa-register").then(({ registerSW }) => registerSW({ immediate: true })).catch(() => {});
        }
      </script>
    )}
  </head>
  <body
    class="min-h-screen bg-background text-foreground font-sans antialiased"
  >
    <AnimatedBackground client:idle="react" transition:persist="animated-bg" />
    <slot />
    {!isMusicPage && siteConfig.features.miniPlayer.enable && <MiniPlayer />}

    <!-- Back to top -->
    <button id="back-to-top" aria-label={locale === "en" ? "Back to top" : "返回顶部"} style="display: none;">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>
    <script is:inline>
      if (!window.__bttInit) {
        window.__bttInit = true;
        var ticking = false;
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            var btn = document.getElementById("back-to-top");
            if (btn) btn.classList.toggle("show", window.scrollY > 400);
            ticking = false;
          });
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        document.addEventListener("click", function (e) {
          if (e.target.closest && e.target.closest("#back-to-top")) {
            window.scrollTo({ top: 0, behavior: "smooth" });
          }
        });
      }
      // View Transitions 换页后按钮是新元素,重新显示并同步状态
      var btt = document.getElementById("back-to-top");
      if (btt) {
        btt.style.display = "";
        btt.classList.toggle("show", window.scrollY > 400);
      }
    </script>

    <!-- Image loading placeholder (uiverse mobinkakei/grumpy-turtle-41) -->
    <script is:inline>
      (function () {
        if (window.__imgPlaceholderInit) return;
        window.__imgPlaceholderInit = true;
        // 灯箱（Fancybox）的 DOM 不参与占位系统，避免拖慢开关动画
        function inFancybox(el) {
          return !!(el.closest && el.closest(".fancybox__container"));
        }
        function mount(img) {
          if (img.dataset.imgLoader) return;
          if (inFancybox(img)) return;
          img.dataset.imgLoader = "1";
          if (img.complete && img.naturalWidth > 0) return;
          var parent = img.parentElement;
          if (!parent) return;
          var overlay = document.createElement("div");
          overlay.className = "img-loading-overlay";
          overlay.innerHTML =
            '<div class="pl-wrapper"><div class="pl-circle"></div><div class="pl-circle"></div><div class="pl-circle"></div><div class="pl-shadow"></div><div class="pl-shadow"></div><div class="pl-shadow"></div></div>';
          var pr = parent.getBoundingClientRect();
          var ir = img.getBoundingClientRect();
          if (getComputedStyle(parent).position === "static") {
            parent.style.position = "relative";
            pr = parent.getBoundingClientRect();
          }
          // 全站 html 设置了 zoom（global.css: clamp(0.5, 100vw/1600px, 2)）。
          // getBoundingClientRect() 返回视觉像素，而 style.left/top/width 用布局像素，
          // 必须除以 zoom，否则占位框会随 zoom 放大/缩小并相对真实图片错位（侧边头像已复现）。
          var zoom = parseFloat(getComputedStyle(document.documentElement).zoom) || 1;
          var iw = ir.width / zoom;
          var ih = ir.height / zoom;
          overlay.style.left = (ir.left - pr.left) / zoom + "px";
          overlay.style.top = (ir.top - pr.top) / zoom + "px";
          overlay.style.width = iw + "px";
          overlay.style.height = ih + "px";
          var scale = Math.min(
            1,
            iw / 200 || 0,
            ih / 60 || 0,
          );
          if (scale > 0 && scale < 1) {
            overlay.style.setProperty("--pl-scale", scale.toFixed(3));
          }
          parent.appendChild(overlay);
          img.__plOverlay = overlay;
          var done = function () {
            if (!overlay.parentNode) return;
            overlay.classList.add("done");
            setTimeout(function () {
              overlay.remove();
            }, 250);
          };
          img.addEventListener("load", done);
          img.addEventListener("error", done);
          if (img.complete) done();
        }
        function scan(root) {
          (root || document)
            .querySelectorAll("img")
            .forEach(mount);
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function () {
            scan();
          });
        } else {
          scan();
        }
        // Images added later (filters, dynamic panels) get placeholders too;
        // removed images take their placeholder with them
        var cleanupRemoved = function (node) {
          if (node.tagName === "IMG") {
            if (node.__plOverlay) {
              node.__plOverlay.remove();
              node.__plOverlay = null;
            }
          } else if (node.querySelectorAll) {
            node.querySelectorAll("img").forEach(function (img) {
              if (img.__plOverlay) {
                img.__plOverlay.remove();
                img.__plOverlay = null;
              }
            });
          }
        };
        var observer = new MutationObserver(function (mutations) {
          mutations.forEach(function (m) {
            m.addedNodes.forEach(function (node) {
              if (!node.tagName) return;
              // Fancybox 打开时会批量插入 DOM，跳过以免卡顿
              if (node.classList && node.classList.contains("fancybox__container")) return;
              if (inFancybox(node)) return;
              if (node.tagName === "IMG") mount(node);
              else if (node.querySelectorAll && !node.querySelector(".fancybox__container")) scan(node);
            });
            m.removedNodes.forEach(function (node) {
              if (node.tagName && !inFancybox(node)) cleanupRemoved(node);
            });
          });
        });
        observer.observe(document.documentElement, {
          childList: true,
          subtree: true,
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  @import "@/styles/global.css";

  /* ===== Image loading placeholder ===== */
  .img-loading-overlay {
    position: absolute;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.04);
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .img-loading-overlay.done {
    opacity: 0;
  }
  .dark .img-loading-overlay {
    background: rgba(255, 255, 255, 0.06);
  }
  .img-loading-overlay .pl-wrapper {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) scale(var(--pl-scale, 1));
  }

  .pl-wrapper {
    width: 200px;
    height: 60px;
    position: relative;
    z-index: 1;
  }

  .pl-circle {
    width: 20px;
    height: 20px;
    position: absolute;
    border-radius: 50%;
    background-color: var(--color-primary);
    left: 15%;
    transform-origin: 50%;
    animation: pl-circle7124 0.5s alternate infinite ease;
  }

  @keyframes pl-circle7124 {
    0% {
      top: 60px;
      height: 5px;
      border-radius: 50px 50px 25px 25px;
      transform: scaleX(1.7);
    }

    40% {
      height: 20px;
      border-radius: 50%;
      transform: scaleX(1);
    }

    100% {
      top: 0%;
    }
  }

  .pl-circle:nth-child(2) {
    left: 45%;
    animation-delay: 0.2s;
  }

  .pl-circle:nth-child(3) {
    left: auto;
    right: 15%;
    animation-delay: 0.3s;
  }

  .pl-shadow {
    width: 20px;
    height: 4px;
    border-radius: 50%;
    background-color: rgba(0, 0, 0, 0.35);
    position: absolute;
    top: 62px;
    transform-origin: 50%;
    z-index: -1;
    left: 15%;
    filter: blur(1px);
    animation: pl-shadow046 0.5s alternate infinite ease;
  }

  @keyframes pl-shadow046 {
    0% {
      transform: scaleX(1.5);
    }

    40% {
      transform: scaleX(1);
      opacity: 0.7;
    }

    100% {
      transform: scaleX(0.2);
      opacity: 0.4;
    }
  }

  .pl-shadow:nth-child(4) {
    left: 45%;
    animation-delay: 0.2s;
  }

  .pl-shadow:nth-child(5) {
    left: auto;
    right: 15%;
    animation-delay: 0.3s;
  }

  /* ===== Back to top ===== */
  #back-to-top {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 9990;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    color: var(--color-foreground);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.45));
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
  }
  #back-to-top.show {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  #back-to-top:hover {
    color: var(--color-primary);
  }
  .dark #back-to-top {
    background: linear-gradient(135deg, rgba(30, 30, 40, 0.7), rgba(30, 30, 40, 0.4));
    border-color: rgba(255, 255, 255, 0.1);
  }
  /* 文章页 <1280 时右下角有 TOC 浮动按钮，向上让位 */
  @media (max-width: 1279px) {
    body:has(#toc-fab) #back-to-top {
      bottom: 140px;
    }
  }

  .dark .pl-circle {
    background-color: var(--color-primary-dark);
  }
</style>

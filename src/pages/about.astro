---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/astro/Header.astro";
import Footer from "@/components/astro/Footer.astro";
import aboutData from "@/content/data/about.json";
import { useTranslations, getLocaleFromURL } from "@/i18n";

const locale = getLocaleFromURL(Astro.url.pathname);
const t = useTranslations(locale);
const about = aboutData as any;
const posts = await getCollection("blog");
---

<BaseLayout title={t("about.title")}>
  <Header />
  <main class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <!-- Hero -->
    <section class="mb-12 flex flex-col items-center text-center">
      <img
        src={about.avatarImg}
        alt={about.name}
        class="mb-4 h-28 w-28 rounded-full object-cover shadow-lg"
      />
      <h1 class="text-3xl font-bold text-foreground">{about.name}</h1>
      <p class="mt-2 text-muted">{about.description}</p>
      <p class="mt-1 text-sm italic text-muted">"{about.subtitle}"</p>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        {
          about.avatarSkills.left.map((s: string) => (
            <span class="rounded-full bg-primary/10 px-3 py-1 text-xs text-primary">
              {s}
            </span>
          ))
        }
        {
          about.avatarSkills.right.map((s: string) => (
            <span class="rounded-full bg-primary/10 px-3 py-1 text-xs text-primary">
              {s}
            </span>
          ))
        }
      </div>
    </section>

    <!-- Self Info -->
    <section class="mb-10 rounded-xl border border-border bg-card p-6">
      <h2 class="mb-4 text-xl font-bold text-foreground">
        {t("about.personalInfo")}
      </h2>
      <div class="flex flex-col sm:flex-row gap-6">
        <!-- Left: Personal Info -->
        <div class="flex-1 flex flex-col gap-4">
          <div class="flex items-center gap-3">
            <span class="text-lg">💼</span>
            <div>
              <p class="text-xs text-muted">{about.selfInfo.selfInfoTips}</p>
              <p class="font-medium text-foreground">
                {about.selfInfo.selfInfoContent}
              </p>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-lg">🧠</span>
            <div>
              <p class="text-xs text-muted">
                {about.personalities.author_name}
              </p>
              <a
                href={about.personalities.name_url}
                target="_blank"
                class="font-medium text-primary hover:underline"
                >{about.personalities.personality_type}</a
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Location -->
    <section
      class="mb-10 rounded-xl border border-border bg-card overflow-hidden"
    >
      <div
        class="relative h-40 bg-cover bg-center"
        style={`background-image: url(${about.map.background})`}
      >
        <div class="absolute inset-0 bg-black/30 flex items-end p-4">
          <div>
            <p class="text-xs text-white/80">{about.map.title}</p>
            <p class="text-lg font-bold text-white">
              {about.map.StrengthenTitle}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Game & Comics Row -->
    <section class="mb-10 flex flex-col sm:flex-row gap-4">
      <!-- Game Card -->
      <div
        class="sm:w-[55%] rounded-2xl overflow-hidden relative min-h-[280px] bg-border game-content"
      >
        <div class="absolute top-5 left-5 z-20">
          <div class="text-2xl font-bold text-white">
            {about.game.game_title}
          </div>
        </div>
        <div
          class="game-box absolute inset-0 flex overflow-hidden"
          style="width: 115%; left: -7.5%;"
        >
          {
            about.game.game_list.map((item: any, i: number) => (
              <div
                class="game-item relative flex-1 overflow-hidden group transition-all duration-500 hover:z-10 hover:flex-[2.3]"
                title={item.name}
                style="transform: skew(-10deg, 0deg); contain: paint;"
              >
                <div
                  class="absolute top-0 h-full transition-all duration-500"
                  style={`left: ${i === 0 ? '-30%' : '-20%'}; width: ${i === 0 ? '150%' : '200%'}; transform: skew(10deg, 0deg);`}
                >
                  <img
                    src={item.bg}
                    alt={item.name}
                    class="h-full max-w-none object-cover transition-transform duration-500 group-hover:scale-[1.4]"
                    loading="lazy"
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Comics Card -->
      <div
        class="sm:w-[45%] rounded-2xl overflow-hidden relative min-h-[280px] bg-border comic-content"
      >
        <div class="absolute top-5 left-5 z-20">
          <p class="text-xs text-white/70 mb-1">{about.comic.comic_tips}</p>
          <div class="text-2xl font-bold text-white">
            {about.comic.comic_title}
          </div>
        </div>
        <div
          class="comic-box absolute inset-0 flex overflow-hidden"
          style="width: 115%; left: -7.5%;"
        >
          {
            about.comic.comic_list.map((item: any, i: number) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="comic-item relative flex-1 overflow-hidden group transition-all duration-500 hover:z-10 hover:flex-[2.3]"
                title={item.name}
                style="transform: skew(-10deg, 0deg); contain: paint;"
              >
                <div
                  class="absolute top-0 h-full transition-all duration-500"
                  style="left: -50%; width: 200%; transform: skew(10deg, 0deg);"
                >
                  <img
                    src={item.cover}
                    alt={item.name}
                    class="h-full max-w-none object-cover transition-transform duration-500 group-hover:scale-[1.4]"
                    loading="lazy"
                  />
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section class="mb-10">
      <h2 class="mb-4 text-xl font-bold text-foreground">
        {t("about.skills")}
      </h2>
      <div
        class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 gap-4"
      >
        {
          about.skills.map((skill: any, i: number) => (
            <div
              class="group card flex flex-col items-center gap-2 p-4 cursor-default"
              style={`animation: fade-in-up 0.4s ease ${i * 0.06}s backwards; transition: all 0.3s ease;`}
            >
              <div
                class="relative flex h-12 w-12 items-center justify-center rounded-xl transition-all duration-300 group-hover:scale-110 group-hover:rotate-3"
                style={`background: rgba(66,90,239,0.07);`}
              >
                <img
                  src={skill.icon}
                  alt={skill.name}
                  class="h-8 w-8 object-contain"
                  loading="lazy"
                />
              </div>
              <span class="text-xs font-medium text-foreground transition-colors group-hover:text-primary">
                {skill.name}
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Statistics -->
    <section
      class="mb-10 rounded-xl border border-border bg-card overflow-hidden"
    >
      <div
        class="relative h-32 bg-cover bg-center"
        style={`background-image: url(${about.statistic.cover})`}
      >
        <a
          href={about.statistic.link}
          class="absolute inset-0 bg-black/40 flex items-center justify-center hover:bg-black/50 transition-colors"
        >
          <div class="text-center">
            <p class="text-2xl font-bold text-white">{posts.length}</p>
            <p class="text-sm text-white/80">{about.statistic.text}</p>
          </div>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .comic-item:hover > div,
  .game-item:hover > div {
    left: 0 !important;
    width: 100% !important;
  }
</style>

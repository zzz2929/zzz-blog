  <script is:inline>
    const T = window.__MUSIC_T__ || {
      notPlaying: '未播放',
      selectSong: '选择歌曲开始播放',
      noLyrics: '暂无歌词',
      unknownAlbum: '未知专辑',
      emptyPlaylist: '播放列表为空',
      removeFromList: '从列表移除',
      singleLoop: '单曲循环',
      shufflePlay: '随机播放',
      playMode: '顺序播放',
    };

    const MUSIC_DATA = window.__MUSIC_DATA__ || [];
    const LYRIC_SETTINGS_KEY = "music-lyric-settings";
    // 音量与歌词显示默认值来自 src/config/site.ts（music.*）
    const LYRIC_DEFAULTS = JSON.parse(lyricDefaultsJSON || "{}");

    class MusicPlayer {
      constructor() {
        this.audio = new Audio();
        // 音源（meting 及其 CDN）全链路带 CORS 头，标注后 Web Audio 才能读到真实频谱
        this.audio.crossOrigin = "anonymous";
        this.playlist = [];
        this.currentIndex = 0;
        this.isPlaying = false;
        this.playMode = 0; // 0=sequential, 1=single loop, 2=shuffle
        this.volume = defaultVolume;
        this.lyrics = [];
        this.translations = [];
        this.lyricsLoadId = 0; // 歌词请求代际号，切歌后作废在途请求
        this.isFullscreen = false;
        this.playlists = [];
        this.expandedPlaylist = -1;
        this.lyricsUserScrolled = false;
        this.lyricsScrollTimeout = null;
        this.fsUserScrolled = false;
        this.fsScrollTimeout = null;
        this.activeLyricIndex = -1;
        this.activeFullIndex = -1;
        this.lyricOffset = 0; // 正值延后歌词、负值提前，单位秒
        this.wordByWord = LYRIC_DEFAULTS.wordByWord ?? true;
        this.fontScale = LYRIC_DEFAULTS.fontScale ?? 1; // 歌词字号倍率
        this.blurEffect = LYRIC_DEFAULTS.blurEffect ?? true; // 未唱字模糊效果
        this.showTranslation = LYRIC_DEFAULTS.showTranslation ?? true; // 全屏翻译显示
        this.autoScroll = LYRIC_DEFAULTS.autoScroll ?? true; // 歌词自动跟随滚动
        this.audioCtx = null; // 真实频谱：Web Audio 图
        this.analyser = null;
        this.freqData = null;
        this.waveformEl = null;
        this.waveBars = [];
        this.waveReal = false; // 真实频谱模式是否生效
        this._spectrumProbe = false; // 图初始化后的全零探测
        this._zeroFrames = 0;
        this._corsRetriedFor = -1; // 已做过去 CORS 重试的歌曲
        this.reduceMotion =
          window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ??
          false;
        this._lyricTick = () => {
          this.updateLyrics(this.audio.currentTime);
          this.updateFullscreenLyrics(this.audio.currentTime);
        };
        this._spectrumTick = () => this.updateSpectrum();

        this.initElements();
        this.loadLyricSettings();
        // 初始就算一次主题色，未播放时音律条/歌词也有正确的强调色
        this.syncLyricColor();
        this.applyLyricPreferences();
        this.initEventListeners();
        this.initLyricSettings();
        this.loadDefaultPlaylist();
        this.loadPlaylists();
        this.switchTab("playlist");
        this.initFooterObserver();

        // Restore saved state after all data is loaded
        setTimeout(() => this.restoreSavedState(), 100);
      }

      initElements() {
        // Main player elements (may not exist)
        this.playBtn = document.getElementById("play-btn");
        this.playIcon = document.getElementById("play-icon");
        this.pauseIcon = document.getElementById("pause-icon");
        this.prevBtn = document.getElementById("prev-btn");
        this.nextBtn = document.getElementById("next-btn");
        this.muteBtn = document.getElementById("mute-btn");
        this.modeBtn = document.getElementById("fixed-mode-btn");
        this.volumeSlider = document.getElementById("volume-slider");
        this.progressBar = document.querySelector(".progress-bar");
        this.progress = document.getElementById("progress");
        this.currentTimeEl = document.getElementById("current-time");
        this.durationEl = document.getElementById("duration");
        this.songTitle = document.getElementById("song-title");
        this.songArtist = document.getElementById("song-artist");
        this.songAlbum = document.getElementById("song-album");
        this.albumCover = document.getElementById("album-cover");
        this.playlistEl = document.getElementById("playlist");

        this.lyricsEl = document.getElementById("lyrics");
        this.vinylRecord = document.getElementById("vinyl-record");
        this.tonearm = document.querySelector(".player");
        this.waveformEl = document.getElementById("waveform");
        this.waveBars = this.waveformEl
          ? [...this.waveformEl.querySelectorAll("span")]
          : [];

        // Tab panel elements
        this.tabPlaylistBtn = document.getElementById("tab-playlist-btn");
        this.tabLyricsBtn = document.getElementById("tab-lyrics-btn");
        this.playlistTab = document.getElementById("playlist-tab");
        this.lyricsTab = document.getElementById("lyrics-tab");

        // Fixed controls
        this.fixedAlbumCover = document.getElementById("fixed-album-cover");
        this.fixedSongTitle = document.getElementById("fixed-song-title");
        this.fixedSongArtist = document.getElementById("fixed-song-artist");
        this.fixedPlayBtn = document.getElementById("fixed-play-btn");
        this.fixedPlayIcon = document.getElementById("fixed-play-icon");
        this.fixedPauseIcon = document.getElementById("fixed-pause-icon");
        this.fixedPrevBtn = document.getElementById("fixed-prev-btn");
        this.fixedNextBtn = document.getElementById("fixed-next-btn");
        this.fixedMuteBtn = document.getElementById("fixed-mute-btn");
        this.fixedVolumeSlider = document.getElementById("fixed-volume-slider");
        this.fixedProgress = document.getElementById("fixed-progress");
        this.fixedProgressBar = document.getElementById("fixed-progress-bar");
        this.fixedCurrentTime = document.getElementById("fixed-current-time");
        this.fixedDuration = document.getElementById("fixed-duration");

        // Fullscreen lyrics
        this.fullscreenLyrics = document.getElementById("fullscreen-lyrics");
        this.fullscreenBtn = document.getElementById("fullscreen-lyrics-btn");
        this.closeFullscreenBtn = document.getElementById("close-fullscreen");
        this.lyricsBackground = document.getElementById("lyrics-background");
        this.lyricsAlbumCover = document.getElementById("lyrics-album-cover");
        this.lyricsSongTitle = document.getElementById("lyrics-song-title");
        this.lyricsSongArtist = document.getElementById("lyrics-song-artist");
        this.lyricsScrollContainer = document.getElementById(
          "lyrics-scroll-container",
        );
        this.fullscreenLyricsContent = document.getElementById(
          "fullscreen-lyrics-content",
        );
        this.lyricsProgress = document.getElementById("lyrics-progress");
        this.lyricsCurrentTime = document.getElementById("lyrics-current-time");
        this.lyricsDuration = document.getElementById("lyrics-duration");
        this.lyricsPlayBtn = document.getElementById("lyrics-play-btn");
        this.lyricsPlayIcon = document.getElementById("lyrics-play-icon");
        this.lyricsPauseIcon = document.getElementById("lyrics-pause-icon");
        this.lyricsPrevBtn = document.getElementById("lyrics-prev-btn");
        this.lyricsNextBtn = document.getElementById("lyrics-next-btn");
      }

      initEventListeners() {
        // Main controls
        if (this.playBtn)
          this.playBtn.addEventListener("click", () => this.togglePlay());
        if (this.prevBtn)
          this.prevBtn.addEventListener("click", () => this.prev());
        if (this.nextBtn)
          this.nextBtn.addEventListener("click", () => this.next());
        if (this.muteBtn)
          this.muteBtn.addEventListener("click", () => this.toggleMute());
        if (this.volumeSlider)
          this.volumeSlider.addEventListener("input", (e) =>
            this.setVolume(e.target.value),
          );
        if (this.progressBar) {
          this.progressBar.addEventListener("click", (e) => {
            if (!Number.isFinite(this.audio.duration)) return;
            const rect = this.progressBar.getBoundingClientRect();
            this.audio.currentTime =
              ((e.clientX - rect.left) / rect.width) * this.audio.duration;
          });
        }

        // Tab switching
        if (this.tabPlaylistBtn)
          this.tabPlaylistBtn.addEventListener("click", () =>
            this.switchTab("playlist"),
          );
        if (this.tabLyricsBtn)
          this.tabLyricsBtn.addEventListener("click", () =>
            this.switchTab("lyrics"),
          );

        // Fixed controls
        this.fixedPlayBtn.addEventListener("click", () => this.togglePlay());
        this.fixedPrevBtn.addEventListener("click", () => this.prev());
        this.fixedNextBtn.addEventListener("click", () => this.next());
        this.modeBtn.addEventListener("click", () => this.togglePlayMode());
        this.fixedMuteBtn.addEventListener("click", () => this.toggleMute());

        // Volume slider
        if (this.fixedVolumeSlider) {
          this.fixedVolumeSlider.addEventListener("input", (e) => {
            this.setVolume(parseInt(e.target.value));
            this.audio.muted = false;
            this.updateVolumeIcon();
          });
        }

        // Mouse wheel volume on mute button
        const volumeWrapper = document.getElementById("volume-wrapper");
        const volumePopup = document.getElementById("volume-popup");
        if (volumeWrapper && volumePopup) {
          let hideTimeout;
          const show = () => {
            clearTimeout(hideTimeout);
            volumePopup.classList.remove("hidden");
          };
          const hide = () => {
            hideTimeout = setTimeout(
              () => volumePopup.classList.add("hidden"),
              200,
            );
          };
          volumeWrapper.addEventListener("mouseenter", show);
          volumeWrapper.addEventListener("mouseleave", hide);
          volumePopup.addEventListener("mouseenter", show);
          volumePopup.addEventListener("mouseleave", hide);

          volumeWrapper.addEventListener(
            "wheel",
            (e) => {
              e.preventDefault();
              const delta = e.deltaY > 0 ? -5 : 5;
              this.volume = Math.max(0, Math.min(100, this.volume + delta));
              this.audio.volume = this.volume / 100;
              this.audio.muted = false;
              if (this.fixedVolumeSlider)
                this.fixedVolumeSlider.value = this.volume;
              this.updateVolumeIcon();
            },
            { passive: false },
          );
        }

        // Fixed progress bar
        const progressBar = document.getElementById("fixed-progress-bar");
        if (progressBar) {
          progressBar.addEventListener("click", (e) => {
            if (!Number.isFinite(this.audio.duration)) return;
            const rect = progressBar.getBoundingClientRect();
            this.audio.currentTime =
              ((e.clientX - rect.left) / rect.width) * this.audio.duration;
          });
        }

        // Fullscreen controls
        if (this.fullscreenBtn)
          this.fullscreenBtn.addEventListener("click", () =>
            this.toggleFullscreen(),
          );
        if (this.closeFullscreenBtn)
          this.closeFullscreenBtn.addEventListener("click", () =>
            this.toggleFullscreen(),
          );
        if (this.lyricsPlayBtn)
          this.lyricsPlayBtn.addEventListener("click", () => this.togglePlay());
        if (this.lyricsPrevBtn)
          this.lyricsPrevBtn.addEventListener("click", () => this.prev());
        if (this.lyricsNextBtn)
          this.lyricsNextBtn.addEventListener("click", () => this.next());

        // Pause auto-scroll only on real user input (wheel/touch/scrollbar drag
        // won't fire from programmatic scrolls, so auto-follow never fights itself)
        this.bindUserScrollPause(this.lyricsEl, "lyricsUserScrolled", "lyricsScrollTimeout", "activeLyricIndex", "_el");
        this.bindUserScrollPause(this.lyricsScrollContainer, "fsUserScrolled", "fsScrollTimeout", "activeFullIndex", "_fEl");

        // 窗口尺寸变化会改变 html zoom，旧的滚动位置随之失真，防抖后重新对中
        let recenterTimer;
        window.addEventListener(
          "resize",
          () => {
            clearTimeout(recenterTimer);
            recenterTimer = setTimeout(() => this.recenterLyrics(), 150);
          },
          { passive: true },
        );

        // Fullscreen progress bar
        const lyricsProgressBar = document.querySelector(
          ".lyrics-progress-bar",
        );
        if (lyricsProgressBar) {
          lyricsProgressBar.addEventListener("click", (e) => {
            if (!Number.isFinite(this.audio.duration)) return;
            const rect = lyricsProgressBar.getBoundingClientRect();
            this.audio.currentTime =
              ((e.clientX - rect.left) / rect.width) * this.audio.duration;
          });
        }

        // Audio events
        this.audio.addEventListener("timeupdate", () => this.updateProgress());
        this.audio.addEventListener("play", () => {
          if (window.gsap) window.gsap.ticker.add(this._lyricTick);
          if (window.gsap) window.gsap.ticker.add(this._spectrumTick);
          // 标签页切回等场景下 AudioContext 可能被挂起，恢复它否则音频静音
          if (this.audioCtx) this.audioCtx.resume().catch(() => {});
        });
        this.audio.addEventListener("pause", () => {
          if (window.gsap) window.gsap.ticker.remove(this._lyricTick);
          if (window.gsap) window.gsap.ticker.remove(this._spectrumTick);
          // 暂停/后台标签页后补一次同步，让卡拉OK进度与高亮停在准确位置
          this.updateLyrics(this.audio.currentTime);
          this.updateFullscreenLyrics(this.audio.currentTime);
          // 真实频谱模式下音律条回落到静息态，而不是僵在最后一帧
          if (this.waveReal)
            this.waveBars.forEach((b, i) => {
              b.style.height = 8 + (i % 4) * 2 + "%";
            });
        });
        this.audio.addEventListener("error", () => {
          // 个别音源链路不支持 CORS 时 crossOrigin 会让加载直接失败：
          // 去掉重试一次（此时频谱不可用，音律条退回 CSS 动画，但播放不中断）
          if (
            !this.audio.crossOrigin ||
            this._corsRetriedFor === this.currentIndex
          )
            return;
          this._corsRetriedFor = this.currentIndex;
          const url = this.playlist[this.currentIndex]?.url;
          if (!url) return;
          const wasPlaying = this.isPlaying;
          this.audio.crossOrigin = null;
          this.audio.src = url;
          if (wasPlaying) this.audio.play().catch(() => {});
          this.degradeWaveform();
        });
        this.audio.addEventListener("seeked", () => {
          this.updateLyrics(this.audio.currentTime, true);
          this.updateFullscreenLyrics(this.audio.currentTime, true);
        });
        this.audio.addEventListener("ended", () => this.onSongEnd());
        this.audio.addEventListener("loadedmetadata", () =>
          this.updateDuration(),
        );

        // Keyboard shortcuts
        document.addEventListener("keydown", (e) => {
          if (e.code === "Space" && this.isFullscreen) {
            e.preventDefault();
            this.togglePlay();
          }
          if (e.code === "Escape" && this.isFullscreen) {
            this.toggleFullscreen();
          }
        });

        this.audio.volume = this.volume / 100;

        // Sync state before leaving the page
        window.addEventListener("beforeunload", () => this.syncMiniPlayer());

        // Handle page visibility changes - restore playback when page becomes visible again
        document.addEventListener("visibilitychange", () => {
          if (!document.hidden) {
            // 标签页恢复后内部滚动位置可能失真，重新对中当前行
            this.recenterLyrics();
            if (this.isPlaying) {
              // Page became visible while playing
              const retryPlay = () => {
                this.audio.play().then(() => {
                  this.isPlaying = true;
                  this.updatePlayButton();
                }).catch((e) => {
                  this.isPlaying = false;
                  this.updatePlayButton();
                });
              };
              // Small delay to ensure the page is fully ready
              setTimeout(retryPlay, 300);
            }
          }
        });
      }

      // ====== Data Loading ======
      loadDefaultPlaylist() {
        try {
          if (Array.isArray(MUSIC_DATA)) {
            this.playlist = MUSIC_DATA.map((s) => ({
              title: s.name,
              artist: s.artist,
              album: s.album || T.unknownAlbum,
              url: s.url,
              cover: s.pic || "/music.svg",
              lrc: s.lrc,
            }));
            this.renderPlaylist();
          }
        } catch (e) {
          console.error("Failed to load playlist:", e);
          this.playlist = [];
          this.renderPlaylist();
        }
      }

      // ====== State Restoration ======
      restoreSavedState() {
        try {
          const savedState = localStorage.getItem(storageKey);
          if (!savedState) return;

          const state = JSON.parse(savedState);

          // Only restore if we have a valid playlist in saved state
          if (state.playlist && Array.isArray(state.playlist) && state.playlist.length > 0) {
            // Restore volume first
            if (state.volume !== undefined) {
              this.volume = state.volume;
            }

            // Find the current song in the current playlist
            if (state.index < this.playlist.length && this.playlist[state.index]?.url === state.playlist[state.index]?.url) {
              this.currentIndex = state.index;
              this.loadSong(this.currentIndex);
            } else {
              let found = false;
              for (let i = 0; i < this.playlist.length; i++) {
                if (this.playlist[i].url === state.playlist[state.index]?.url) {
                  this.currentIndex = i;
                  this.loadSong(this.currentIndex);
                  found = true;
                  break;
                }
              }
              if (!found) {
                this.playlist = state.playlist;
                this.currentIndex = state.index || 0;
                this.loadSong(this.currentIndex);
              }
            }

            // Apply volume after loadSong (audio.src resets volume to 1.0)
            this.audio.volume = this.volume / 100;
            this.updateVolumeIcon();
            if (this.fixedVolumeSlider) {
              this.fixedVolumeSlider.value = this.volume;
            }

            // Restore playback mode (saved by syncMiniPlayer)
            if ([0, 1, 2].includes(state.playMode)) {
              this.playMode = state.playMode;
              const titles = [T.playMode, T.singleLoop, T.shufflePlay];
              if (this.modeBtn) {
                this.modeBtn.title = titles[this.playMode];
                this.modeBtn.querySelectorAll(".mode-icon").forEach((icon) => {
                  icon.classList.toggle(
                    "hidden",
                    parseInt(icon.dataset.mode) !== this.playMode,
                  );
                });
              }
            }

            // Set saved playback state - use a more robust approach
            if (state.isPlaying) {
              const playWithRetry = () => {
                this.audio.play().then(() => {
                  this.isPlaying = true;
                  this.updatePlayButton();
                }).catch((e) => {
                  console.error("Failed to restore playback:", e);
                  // If it fails, pause and update UI to reflect actual state
                  this.isPlaying = false;
                  this.updatePlayButton();
                });
              };
              // Small delay to ensure audio is loaded
              setTimeout(playWithRetry, 500);
            }

            // Set current time after audio metadata loads
            if (state.currentTime) {
              const seekToSaved = () => {
                if (this.audio.readyState >= 1) {
                  this.audio.currentTime = state.currentTime;
                  this.updateProgress();
                } else {
                  this.audio.addEventListener("loadedmetadata", () => {
                    this.audio.currentTime = state.currentTime;
                    this.updateProgress();
                  }, { once: true });
                }
              };
              seekToSaved();
            }

            // Update UI
            this.renderPlaylist();
            this.updateDuration();
            this.updateProgress();

            // Sync with mini player
            this.syncMiniPlayer();
          }
        } catch (e) {
          console.error("Failed to restore state:", e);
          // Clear any invalid saved state
          localStorage.removeItem(storageKey);
        }
      }

      loadPlaylists() {
        try {
          this.playlists = window.__PLAYLISTS__ || [];
        } catch (e) {
          this.playlists = [];
        }
        this.initPlaylistCards();
      }

      // ====== 歌单 Cards ======
      initPlaylistCards() {
        document.querySelectorAll(".playlist-card").forEach((card) => {
          const index = parseInt(card.dataset.playlistIndex);
          const header = card.querySelector(".playlist-card-header");
          const body = card.querySelector(".playlist-card-body");
          const chevron = card.querySelector(".playlist-chevron");

          header.addEventListener("click", () => {
            const isExpanding = this.expandedPlaylist !== index;
            document.querySelectorAll(".playlist-card").forEach((c) => {
              c.querySelector(".playlist-card-body").classList.add("hidden");
              c.querySelector(".playlist-card-header").classList.remove(
                "expanded",
              );
              c.querySelector(".playlist-chevron").classList.remove("expanded");
            });
            this.expandedPlaylist = isExpanding ? index : -1;
            if (isExpanding) {
              body.classList.remove("hidden");
              header.classList.add("expanded");
              chevron.classList.add("expanded");
            }
          });
        });

        document.querySelectorAll(".play-all-btn").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.stopPropagation();
            this.playAllFromPlaylist(parseInt(btn.dataset.playlistIndex));
          });
        });

        document.querySelectorAll(".play-song-btn").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.stopPropagation();
            this.playFromPlaylist(
              parseInt(btn.dataset.playlistIndex),
              parseInt(btn.dataset.songIndex),
            );
          });
        });

        document.querySelectorAll(".add-song-btn").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.stopPropagation();
            this.addSongFromPlaylist(
              parseInt(btn.dataset.playlistIndex),
              parseInt(btn.dataset.songIndex),
            );
          });
        });
      }

      playAllFromPlaylist(i) {
        this.playFromPlaylist(i, 0);
      }

      // 将歌单整个载入队列并从 startIndex 直接播放
      playFromPlaylist(i, startIndex) {
        const pl = this.playlists[i];
        if (!pl?.songs?.[startIndex]) return;
        this.playlist = pl.songs.map((s) => ({
          title: s.name,
          artist: s.artist,
          album: s.album || T.unknownAlbum,
          url: s.url,
          cover: s.pic || "/music.svg",
          lrc: s.lrc,
        }));
        this.currentIndex = startIndex;
        this.renderPlaylist();
        this.playSong(startIndex);
      }

      addSongFromPlaylist(pi, si) {
        const pl = this.playlists[pi];
        const song = pl?.songs?.[si];
        if (!song) return;
        const newSong = {
          title: song.name,
          artist: song.artist,
          album: song.album || T.unknownAlbum,
          url: song.url,
          cover: song.pic || "/music.svg",
          lrc: song.lrc,
        };
        this.playlist.splice(this.currentIndex + 1, 0, newSong);
        this.renderPlaylist();
        if (this.playlist.length === 1) this.playSong(0);
      }

      // ====== Playlist Rendering ======
      renderPlaylist() {
        this.playlistEl.innerHTML = "";
        if (!this.playlist.length) {
          this.playlistEl.innerHTML =
            `<div class="p-8 text-center text-muted">${T.emptyPlaylist}</div>`;
          return;
        }
        this.playlist.forEach((song, index) => {
          const item = document.createElement("div");
          item.className = `playlist-item ${index === this.currentIndex ? "active" : ""}`;
          // 歌名/歌手/封面来自外部 JSON，统一转义后再拼 HTML
          const esc = (v) =>
            String(v ?? "").replace(/[&<>"']/g, (c) => ({
              "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
            })[c]);
          item.innerHTML = `
            <span class="song-number">${index + 1}</span>
            <img class="song-cover" src="${esc(song.cover)}" alt="" />
            <div class="song-info">
              <div class="song-title">${esc(song.title)}</div>
              <div class="song-artist">${esc(song.artist)}</div>
            </div>
            <button class="playlist-remove-btn" title="${esc(T.removeFromList)}">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          `;
          item.addEventListener("click", () => this.playSong(index));
          item
            .querySelector(".playlist-remove-btn")
            .addEventListener("click", (e) => {
              e.stopPropagation();
              this.removeFromPlaylist(index);
            });
          this.playlistEl.appendChild(item);
        });
      }

      // ====== Song Playback ======
      loadSong(index) {
        if (index < 0 || index >= this.playlist.length) return;
        this.currentIndex = index;
        const song = this.playlist[index];

        // Clear old lyrics immediately
        this.lyrics = [];
        this.translations = [];
        if (this.lyricsEl)
          this.lyricsEl.innerHTML =
            `<p class="text-muted text-lg">${T.noLyrics}</p>`;
        if (this.fullscreenLyricsContent)
          this.fullscreenLyricsContent.innerHTML =
            `<p class="text-2xl opacity-50">${T.noLyrics}</p>`;

        this.audio.src = song.url;
        // 每首歌重新尝试 CORS 标注（前一首批不支持 CORS 的源被 error 兜底去掉后，换歌再试回来）
        this.audio.crossOrigin = "anonymous";
        if (this.songTitle) this.songTitle.textContent = song.title;
        if (this.songArtist) this.songArtist.textContent = song.artist;
        if (this.songAlbum) this.songAlbum.textContent = song.album;
        if (this.albumCover) this.albumCover.src = song.cover;
        if (this.lyricsAlbumCover) this.lyricsAlbumCover.src = song.cover;
        if (this.lyricsSongTitle) this.lyricsSongTitle.textContent = song.title;
        if (this.lyricsSongArtist)
          this.lyricsSongArtist.textContent = song.artist;

        this.fixedAlbumCover.src = song.cover;
        this.fixedSongTitle.textContent = song.title;
        this.fixedSongArtist.textContent = song.artist;

        this.updateBackground();
        document
          .querySelectorAll(".playlist-item")
          .forEach((el, i) => el.classList.toggle("active", i === index));

        if (song.lrc) {
          this.loadLyricsFromUrl(song.lrc);
        } else {
          this.lyricsLoadId++; // 无歌词同样作废在途请求
          this.lyrics = [];
          this.translations = [];
          if (this.lyricsEl)
            this.lyricsEl.innerHTML =
              `<p class="text-muted text-lg">${T.noLyrics}</p>`;
          if (this.fullscreenLyricsContent)
            this.fullscreenLyricsContent.innerHTML =
              `<p class="text-2xl opacity-50">${T.noLyrics}</p>`;
        }
      }

      playSong(index) {
        this.loadSong(index);
        this.initAudioGraph();
        // 自动播放策略可能拒绝播放，catch 避免未处理的 Promise 拒绝
        this.audio.play().catch(() => {});
        this.isPlaying = true;
        this.updatePlayButton();
        this.syncMiniPlayer();
      }

      removeFromPlaylist(index) {
        if (!this.playlist.length) return;
        const wasPlaying = index === this.currentIndex;
        this.playlist.splice(index, 1);

        if (!this.playlist.length) {
          this.audio.pause();
          this.isPlaying = false;
          this.currentIndex = 0;
          this.updatePlayButton();
          this.renderPlaylist();
          return;
        }
        if (wasPlaying) {
          if (this.currentIndex >= this.playlist.length) this.currentIndex = 0;
          this.loadSong(this.currentIndex);
          this.audio.play();
          this.isPlaying = true;
          this.updatePlayButton();
        } else if (index < this.currentIndex) {
          this.currentIndex--;
        }
        this.renderPlaylist();
      }

      togglePlay() {
        if (this.isPlaying) {
          this.audio.pause();
        } else {
          this.initAudioGraph();
          this.audio.play().catch(() => {});
        }
        this.isPlaying = !this.isPlaying;
        this.updatePlayButton();
        this.syncMiniPlayer();
      }

      prev() {
        this.playSong(
          this.currentIndex <= 0
            ? this.playlist.length - 1
            : this.currentIndex - 1,
        );
      }

      next() {
        let i = this.currentIndex + 1;
        if (this.playMode === 2) {
          i = Math.floor(Math.random() * this.playlist.length);
        } else if (i >= this.playlist.length) {
          i = 0;
        }
        this.playSong(i);
      }

      togglePlayMode() {
        this.playMode = (this.playMode + 1) % 3;
        const titles = [T.playMode, T.singleLoop, T.shufflePlay];
        this.modeBtn.title = titles[this.playMode];
        this.modeBtn.querySelectorAll(".mode-icon").forEach((icon) => {
          icon.classList.toggle(
            "hidden",
            parseInt(icon.dataset.mode) !== this.playMode,
          );
        });
        this.modeBtn.classList.toggle("active", this.playMode > 0);
      }

      toggleMute() {
        this.audio.muted = !this.audio.muted;
        this.updateVolumeIcon();
      }

      updateVolumeIcon() {
        const vol = this.audio.muted ? 0 : this.volume;
        document.querySelectorAll(".vol-icon").forEach((icon) => {
          const type = icon.dataset.vol;
          icon.classList.toggle(
            "hidden",
            (type === "high" && vol <= 60) ||
              (type === "medium" && (vol === 0 || vol > 60)) ||
              (type === "muted" && vol > 0),
          );
        });
        this.updateVolumeSlider();
      }

      updateVolumeSlider() {
        if (!this.fixedVolumeSlider) return;
        const vol = this.audio.muted ? 0 : this.volume;
        const fg =
          getComputedStyle(document.documentElement)
            .getPropertyValue("--color-foreground")
            .trim() || "#1F2D3D";
        const bg = document.documentElement.classList.contains("dark")
          ? "#555"
          : "#ddd";
        this.fixedVolumeSlider.style.background = `linear-gradient(to top, ${fg} 0%, ${fg} ${vol}%, ${bg} ${vol}%, ${bg} 100%)`;
      }

      switchTab(tab) {
        const isPlaylist = tab === "playlist";
        this.tabPlaylistBtn.classList.toggle("active", isPlaylist);
        this.tabLyricsBtn.classList.toggle("active", !isPlaylist);
        this.playlistTab.classList.toggle("hidden", !isPlaylist);
        this.lyricsTab.classList.toggle("hidden", isPlaylist);
        if (!isPlaylist)
          this.updateLyrics(this.audio.currentTime, true);
      }

      setVolume(value) {
        this.volume = parseInt(value);
        this.audio.volume = this.volume / 100;
        if (this.fixedVolumeSlider) this.fixedVolumeSlider.value = this.volume;
        this.updateVolumeIcon();
      }

      toggleFullscreen() {
        if (!this.fullscreenLyrics) return;
        this.isFullscreen = !this.isFullscreen;
        this.fullscreenLyrics.classList.toggle("hidden", !this.isFullscreen);
        document.body.style.overflow = this.isFullscreen ? "hidden" : "";
        if (this.isFullscreen)
          this.updateFullscreenLyrics(this.audio.currentTime, true);
        else
          document
            .querySelectorAll(".lyric-settings-popover")
            .forEach((p) => p.classList.add("hidden"));
      }

      // ====== UI Updates ======
      updatePlayButton() {
        if (this.playIcon)
          this.playIcon.classList.toggle("hidden", this.isPlaying);
        if (this.pauseIcon)
          this.pauseIcon.classList.toggle("hidden", !this.isPlaying);
        if (this.fixedPlayIcon)
          this.fixedPlayIcon.classList.toggle("hidden", this.isPlaying);
        if (this.fixedPauseIcon)
          this.fixedPauseIcon.classList.toggle("hidden", !this.isPlaying);
        if (this.lyricsPlayIcon)
          this.lyricsPlayIcon.classList.toggle("hidden", this.isPlaying);
        if (this.lyricsPauseIcon)
          this.lyricsPauseIcon.classList.toggle("hidden", !this.isPlaying);
        if (this.vinylRecord)
          this.vinylRecord.classList.toggle("playing", this.isPlaying);
        if (this.tonearm)
          this.tonearm.classList.toggle("playing", this.isPlaying);
        const waveform = document.getElementById("waveform");
        if (waveform) waveform.classList.toggle("playing", this.isPlaying);
      }

      updateProgress() {
        const { currentTime, duration } = this.audio;
        if (!duration) return;
        const pct = (currentTime / duration) * 100;
        if (this.progress) this.progress.style.width = `${pct}%`;
        if (this.currentTimeEl)
          this.currentTimeEl.textContent = this.formatTime(currentTime);
        if (this.fixedProgress) this.fixedProgress.style.width = `${pct}%`;
        if (this.fixedCurrentTime)
          this.fixedCurrentTime.textContent = this.formatTime(currentTime);
        if (this.lyricsProgress) this.lyricsProgress.style.width = `${pct}%`;
        if (this.lyricsCurrentTime)
          this.lyricsCurrentTime.textContent = this.formatTime(currentTime);
      }

      updateDuration() {
        const d = this.audio.duration;
        if (this.durationEl) this.durationEl.textContent = this.formatTime(d);
        if (this.fixedDuration)
          this.fixedDuration.textContent = this.formatTime(d);
        if (this.lyricsDuration)
          this.lyricsDuration.textContent = this.formatTime(d);
      }

      onSongEnd() {
        if (this.playMode === 1) {
          this.audio.currentTime = 0;
          this.audio.play();
        } else {
          this.next();
        }
      }

      initFooterObserver() {
        const footer = document.querySelector("footer");
        const controls = document.getElementById("fixed-controls");
        if (!footer || !controls) return;

        const update = () => {
          const footerRect = footer.getBoundingClientRect();
          const overlap = window.innerHeight - footerRect.top;
          controls.style.bottom = overlap > 0 ? overlap + "px" : "0px";
        };

        window.addEventListener("scroll", update, { passive: true });
        window.addEventListener("resize", update, { passive: true });
        update();
      }

      // ====== 真实频谱音律条 ======
      /**
       * 建立 Web Audio 图（元素 → 分析器 → 输出），驱动音律条随真实频谱律动。
       * 只能在用户手势触发的播放路径里调用：否则 AudioContext 保持挂起，
       * 路由进图里的音乐会静音。失败时音律条保持 CSS 动画，不影响播放。
       */
      initAudioGraph() {
        if (this.audioCtx || !this.waveBars.length) return;
        try {
          const Ctx = window.AudioContext || window.webkitAudioContext;
          if (!Ctx) return;
          this.audioCtx = new Ctx();
          const source = this.audioCtx.createMediaElementSource(this.audio);
          this.analyser = this.audioCtx.createAnalyser();
          this.analyser.fftSize = 256;
          this.analyser.smoothingTimeConstant = 0.8;
          // 默认量程(-100~-30dB)下音乐常态就顶格，收窄量程留出动态空间
          this.analyser.minDecibels = -80;
          this.analyser.maxDecibels = -12;
          this.freqData = new Uint8Array(this.analyser.frequencyBinCount);
          source.connect(this.analyser);
          this.analyser.connect(this.audioCtx.destination);
          this.waveReal = true;
          this._spectrumProbe = true;
          this._zeroFrames = 0;
          if (this.waveformEl) this.waveformEl.classList.add("real");
          this.audioCtx.resume().catch(() => {});
        } catch (e) {
          console.warn("频谱初始化失败，音律条退回 CSS 动画", e);
          this.waveReal = false;
        }
      }

      /** 真实频谱不可用时退回 CSS 动画（跨域污染 / 加载失败兜底） */
      degradeWaveform() {
        this.waveReal = false;
        this._spectrumProbe = false;
        if (this.waveformEl) this.waveformEl.classList.remove("real");
      }

      /**
       * 每帧把频谱数据按对数分桶写进 30 根音律条（百分比高度，随容器缩放）。
       * 音乐能量集中在中低频，只取前 3/4 的 bin；桶内取峰值让节奏更跟手。
       * 每根条独立做"快起慢落"平滑，律动比纯数据更连贯。
       */
      updateSpectrum() {
        if (!this.analyser || !this.waveReal || !this.waveBars.length) return;
        this.analyser.getByteFrequencyData(this.freqData);
        const bins = this.freqData.length;
        const n = this.waveBars.length;
        const usable = Math.floor(bins * 0.75);
        if (!this._barLevels || this._barLevels.length !== n)
          this._barLevels = new Array(n).fill(0);
        let sum = 0;
        for (let i = 0; i < n; i++) {
          const lo = Math.floor(Math.pow(usable, i / n));
          const hi = Math.max(lo + 1, Math.floor(Math.pow(usable, (i + 1) / n)));
          let peak = 0;
          for (let j = lo; j < hi; j++)
            if (this.freqData[j] > peak) peak = this.freqData[j];
          // 高频天然偏弱，做一点倾斜补偿
          const v = Math.min((peak / 255) * (1 + (i / n) * 0.35), 1);
          sum += v;
          // 快起慢落：起音快速逼近，衰减缓慢滑落
          const level = this._barLevels[i];
          this._barLevels[i] =
            v > level ? level + (v - level) * 0.4 : level + (v - level) * 0.14;
          // 指数 >1 压低小信号：轻微声音小幅起伏，强拍才打满
          const p = Math.pow(this._barLevels[i], 1.5);
          this.waveBars[i].style.height = (8 + p * 92).toFixed(1) + "%";
        }
        // 初始化后的探测期：音频在走但数据持续全零，说明源被跨域污染，退回 CSS
        if (this._spectrumProbe && !this.audio.paused) {
          if (sum > 0.5) {
            this._spectrumProbe = false;
          } else if (++this._zeroFrames > 180) {
            this.degradeWaveform();
          }
        }
      }

      formatTime(s) {
        return `${Math.floor(s / 60)
          .toString()
          .padStart(2, "0")}:${Math.floor(s % 60)
          .toString()
          .padStart(2, "0")}`;
      }

      syncMiniPlayer() {
        const song = this.playlist[this.currentIndex];
        if (!song) return;
        try {
          const state = {
            title: song.title,
            artist: song.artist,
            cover: song.cover,
            url: song.url,
            playlist: this.playlist.map((s) => ({
              title: s.title,
              artist: s.artist,
              cover: s.cover,
              url: s.url,
              lrc: s.lrc, // 必须保留，否则恢复的播放列表永远匹配不到歌词
            })),
            index: this.currentIndex,
            currentTime: this.audio.currentTime,
            isPlaying: this.isPlaying,
            volume: this.volume, // Use saved volume instead of audio.volume which might be affected by mute
            playMode: this.playMode,
            timestamp: Date.now(), // Add timestamp to help detect stale state
          };
          localStorage.setItem(storageKey, JSON.stringify(state));
        } catch (e) {
          console.error("Failed to sync mini player state:", e);
        }
      }

      // ====== Background & Colors ======
      updateBackground() {
        const hue = Math.random() * 360;
        if (this.lyricsBackground) {
          this.lyricsBackground.style.background = `linear-gradient(135deg, hsl(${hue}, 70%, 20%) 0%, hsl(${hue + 30}, 60%, 15%) 50%, hsl(${hue + 60}, 50%, 10%) 100%)`;
        }
        this.syncLyricColor();
        this.initThemeObserver();
      }

      syncLyricColor() {
        const bg = getComputedStyle(document.body).backgroundColor;
        const m = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
        if (!m) return;
        const r = +m[1],
          g = +m[2],
          b = +m[3];
        const max = Math.max(r, g, b),
          min = Math.min(r, g, b);
        const l = (max + min) / 510;
        let h = 0;
        if (max !== min) {
          const d = max - min;
          if (max === r) h = ((g - b) / d + (g < b ? 6 : 0)) * 60;
          else if (max === g) h = ((b - r) / d + 2) * 60;
          else h = ((r - g) / d + 4) * 60;
        }
        const lyricColor = `hsl(${(h + 180) % 360}, ${Math.min(70, 40 + l * 30)}%, ${45 + l * 15}%)`;
        if (this.lyricsEl) {
          this.lyricsEl.style.setProperty("--lyric-active-color", lyricColor);
          this.lyricsEl.style.setProperty("--glow-color", lyricColor);
        }
        // 音律条与歌词共用同一主题色
        if (this.waveformEl) {
          this.waveformEl.style.setProperty("--lyric-active-color", lyricColor);
        }
      }

      initThemeObserver() {
        if (this._themeObserved) return;
        this._themeObserved = true;
        new MutationObserver(() => this.syncLyricColor()).observe(
          document.body,
          { attributes: true, attributeFilter: ["style", "class"] },
        );
        new MutationObserver(() => this.syncLyricColor()).observe(
          document.documentElement,
          { attributes: true, attributeFilter: ["class"] },
        );
      }

      // ====== Lyrics ======
      async loadLyricsFromUrl(lrcUrl) {
        // 记录本次请求的代际号；期间再切歌会令其失效，
        // 慢返回的旧歌词直接丢弃，不再覆盖新歌
        const reqId = ++this.lyricsLoadId;
        for (let attempt = 0; attempt < 3; attempt++) {
          try {
            const resp = await fetch(
              `/api/lrc?url=${encodeURIComponent(lrcUrl)}`,
              { signal: AbortSignal.timeout(10000) },
            );
            if (reqId !== this.lyricsLoadId) return;
            if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
            const text = await resp.text();
            if (reqId !== this.lyricsLoadId) return;
            if (!text || text.length < 10) throw new Error("Empty lyrics");
            this.parseLyrics(text);
            return;
          } catch (e) {
            if (reqId !== this.lyricsLoadId) return;
            if (attempt < 2) await new Promise(r => setTimeout(r, 1000));
          }
        }
        if (reqId !== this.lyricsLoadId) return;
        console.warn("Lyrics load failed after 3 attempts");
        this.lyrics = [];
        this.translations = [];
        this.renderLyrics();
        this.renderFullscreenLyrics();
      }

      parseLyrics(text) {
        this.lyrics = [];
        this.translations = [];
        const lineRe = /^\[(\d+),(\d+)\]/;
        const wordRe = /\((\d+),(\d+),\d+\)([^(]*)/g;
        const timeRe = /\[(\d{2}):(\d{2})(?:\.(\d{2,3}))?\]/g;
        const transRe = /(?:翻译|trans|translation)[:\s]*(.*)/i;

        const lines = text.split("\n");
        const isWordByWord = lines.some((l) => lineRe.test(l));

        if (isWordByWord) {
          lines.forEach((line) => {
            const m = line.match(lineRe);
            if (!m) return;
            const lineStart = parseInt(m[1]) / 1000;
            const words = [];
            let wm;
            while ((wm = wordRe.exec(line)) !== null) {
              words.push({
                start: parseInt(wm[1]) / 1000,
                end: (parseInt(wm[1]) + parseInt(wm[2])) / 1000,
                text: wm[3].trim(),
              });
            }
            if (!words.length) return;
            const text = words.map((w) => w.text).join("");
            this.lyrics.push({ time: lineStart, text, words });
          });
        } else {
          lines.forEach((line) => {
            const matches = [...line.matchAll(timeRe)];
            if (!matches.length) return;
            const clean = line.replace(timeRe, "").trim();
            if (!clean) return;
            const isTrans = transRe.test(clean);
            matches.forEach((m) => {
              const time =
                parseInt(m[1]) * 60 +
                parseInt(m[2]) +
                (m[3] ? parseInt(m[3].padEnd(3, "0").slice(0, 3)) : 0) / 1000;
              if (isTrans)
                this.translations.push({
                  time,
                  text: clean.replace(transRe, "$1").trim(),
                });
              else this.lyrics.push({ time, text: clean });
            });
          });
        }

        this.lyrics.sort((a, b) => a.time - b.time);
        this.translations.sort((a, b) => a.time - b.time);
        this.renderLyrics();
        this.renderFullscreenLyrics();
      }

      renderLyrics() {
        if (!this.lyricsEl) return;
        this.lyricsEl.innerHTML = "";
        if (!this.lyrics.length) {
          this.lyricsEl.innerHTML =
            `<p class="text-muted text-lg">${T.noLyrics}</p>`;
          return;
        }
        if (window.gsap) {
          window.gsap.killTweensOf(this.lyricsEl, "scrollTop");
          window.gsap.killTweensOf(this.lyricsScrollContainer, "scrollTop");
        }
        this.activeLyricIndex = -1;
        this.lyricsUserScrolled = false;
        this.fsUserScrolled = false;
        clearTimeout(this.lyricsScrollTimeout);
        clearTimeout(this.fsScrollTimeout);

        const spacer = document.createElement("div");
        spacer.className = "lyric-spacer";
        this.lyricsEl.appendChild(spacer);

        this.lyrics.forEach((lyric) => {
          const useWords = !!(lyric.words && this.wordByWord);
          const div = document.createElement("div");
          div.className = `lyric-line${useWords ? " has-words" : ""}`;
          div.dataset.time = lyric.time;
          lyric._el = div;
          lyric._words = null;

          if (useWords) {
            div.innerHTML = lyric.words
              .map(
                (w) =>
                  `<span class="lyric-word" data-start="${w.start}" data-end="${w.end}">${w.text}</span>`,
              )
              .join("");
            lyric._words = [...div.querySelectorAll(".lyric-word")].map(
              (el) => ({
                el,
                start: parseFloat(el.dataset.start),
                end: parseFloat(el.dataset.end),
                state: "",
              }),
            );
          } else {
            div.innerHTML = `<span class="lyric-text">${lyric.text}</span>`;
          }

          div.addEventListener("click", () => {
            this.audio.currentTime = lyric.time;
            if (!this.isPlaying) {
              this.audio.play();
              this.isPlaying = true;
              this.updatePlayButton();
            }
          });
          this.lyricsEl.appendChild(div);
        });

        const spacerEnd = document.createElement("div");
        spacerEnd.className = "lyric-spacer";
        this.lyricsEl.appendChild(spacerEnd);
      }

      renderFullscreenLyrics() {
        if (!this.fullscreenLyricsContent) return;
        this.fullscreenLyricsContent.innerHTML = "";
        if (!this.lyrics.length) {
          this.fullscreenLyricsContent.innerHTML =
            `<p class="text-2xl opacity-50">${T.noLyrics}</p>`;
          return;
        }
        this.activeFullIndex = -1;
        this.lyrics.forEach((lyric) => {
          const useWords = !!(lyric.words && this.wordByWord);
          const div = document.createElement("div");
          div.className = `lyric-line-full${useWords ? " has-words" : ""}`;
          div.dataset.time = lyric.time;
          lyric._fEl = div;
          lyric._fWords = null;
          if (useWords) {
            div.innerHTML =
              `<span class="lyric-main">` +
              lyric.words
                .map(
                  (w) =>
                    `<span class="lyric-word" data-start="${w.start}" data-end="${w.end}">${w.text}</span>`,
                )
                .join("") +
              `</span>`;
            lyric._fWords = [...div.querySelectorAll(".lyric-word")].map(
              (el) => ({
                el,
                start: parseFloat(el.dataset.start),
                end: parseFloat(el.dataset.end),
                state: "",
              }),
            );
          } else {
            div.innerHTML = `<span class="lyric-main">${lyric.text}</span>`;
          }
          const trans = this.translations.find(
            (t) => Math.abs(t.time - lyric.time) < 0.5,
          );
          if (trans)
            div.innerHTML += `<div class="lyric-translation">${trans.text}</div>`;
          div.addEventListener("click", () => {
            this.audio.currentTime = lyric.time;
          });
          this.fullscreenLyricsContent.appendChild(div);
        });
      }

      /**
       * 找到当前播放行（二分查找）。返回 -1 表示还没唱到第一句。
       */
      findLyricIndex(currentTime) {
        const lines = this.lyrics;
        let lo = 0,
          hi = lines.length - 1,
          res = -1;
        while (lo <= hi) {
          const mid = (lo + hi) >> 1;
          if (currentTime >= lines[mid].time) {
            res = mid;
            lo = mid + 1;
          } else hi = mid - 1;
        }
        return res;
      }

      /**
       * 把某行滚动到容器垂直居中。instant=true 时直接定位（切换标签页/seek），
       * 否则用 GSAP 平滑滚动（逐行跟进）。
       */
      scrollLyricsTo(container, el, instant) {
        if (!container || !el || !container.clientHeight) return;
        const cr = container.getBoundingClientRect();
        const lr = el.getBoundingClientRect();
        const target =
          container.scrollTop +
          (lr.top - cr.top) -
          container.clientHeight / 2 +
          lr.height / 2;
        if (instant || !window.gsap || this.reduceMotion) {
          container.scrollTop = target;
          return;
        }
        window.gsap.to(container, {
          scrollTop: target,
          duration: 0.45,
          ease: "power2.out",
          overwrite: "auto",
        });
      }

      /**
       * 把当前播放行重新对中（窗口尺寸/缩放变化、标签页恢复后
       * 滚动位置会相对新布局失真）。用户手动滚动后的暂停期内不动。
       */
      recenterLyrics() {
        if (!this.autoScroll) return;
        if (!this.lyricsUserScrolled) {
          const line = this.lyrics[this.activeLyricIndex];
          if (line && line._el)
            this.scrollLyricsTo(this.lyricsEl, line._el, true);
        }
        if (this.isFullscreen && !this.fsUserScrolled) {
          const line = this.lyrics[this.activeFullIndex];
          if (line && line._fEl)
            this.scrollLyricsTo(this.lyricsScrollContainer, line._fEl, true);
        }
      }

      /**
       * 只在真实用户输入时暂停自动跟随。
       * wheel/touchmove/pointerdown 都不会由程序滚动触发。
       * 停止操作 3 秒后主动跳回当前播放行，而不是干等下一行开唱才跟上。
       */
      bindUserScrollPause(container, flagName, timerName, indexKey, elKey) {
        if (!container) return;
        const pause = () => {
          if (window.gsap)
            window.gsap.killTweensOf(container, "scrollTop");
          this[flagName] = true;
          clearTimeout(this[timerName]);
          this[timerName] = setTimeout(() => {
            this[flagName] = false;
            if (!this.autoScroll) return;
            const line = this.lyrics[this[indexKey]];
            if (line && line[elKey])
              this.scrollLyricsTo(container, line[elKey], false);
          }, 3000);
        };
        container.addEventListener("wheel", pause, { passive: true });
        container.addEventListener("touchmove", pause, { passive: true });
        container.addEventListener("pointerdown", pause, { passive: true });
      }

      // ====== 歌词设置（偏移 / 逐字开关） ======
      loadLyricSettings() {
        try {
          const s = JSON.parse(
            localStorage.getItem(LYRIC_SETTINGS_KEY) || "{}",
          );
          if (Number.isFinite(s.offset))
            this.lyricOffset = Math.min(Math.max(s.offset, -5), 5);
          if (typeof s.wordByWord === "boolean")
            this.wordByWord = s.wordByWord;
          if (Number.isFinite(s.fontScale) && s.fontScale >= 0.85 && s.fontScale <= 1.4)
            this.fontScale = s.fontScale;
          if (typeof s.blurEffect === "boolean")
            this.blurEffect = s.blurEffect;
          if (typeof s.showTranslation === "boolean")
            this.showTranslation = s.showTranslation;
          if (typeof s.autoScroll === "boolean")
            this.autoScroll = s.autoScroll;
        } catch (e) {
          // 本地设置损坏时按默认值使用
        }
      }

      saveLyricSettings() {
        try {
          localStorage.setItem(
            LYRIC_SETTINGS_KEY,
            JSON.stringify({
              offset: this.lyricOffset,
              wordByWord: this.wordByWord,
              fontScale: this.fontScale,
              blurEffect: this.blurEffect,
              showTranslation: this.showTranslation,
              autoScroll: this.autoScroll,
            }),
          );
        } catch (e) {}
      }

      // 把字号倍率 / 模糊 / 翻译偏好落到 DOM
      applyLyricPreferences() {
        document.documentElement.style.setProperty(
          "--lyric-font-scale",
          String(this.fontScale),
        );
        document.documentElement.classList.toggle(
          "lyric-no-blur",
          !this.blurEffect,
        );
        if (this.fullscreenLyricsContent)
          this.fullscreenLyricsContent.classList.toggle(
            "no-translation",
            !this.showTranslation,
          );
      }

      setLyricOffset(v) {
        // 0.5s 步进，范围 ±5s
        this.lyricOffset = Math.round(Math.min(Math.max(v, -5), 5) * 2) / 2;
        this.saveLyricSettings();
        this.syncLyricSettingsUI();
        // 偏移变化后立即按新时间轴刷新高亮与滚动
        this.updateLyrics(this.audio.currentTime, true);
        this.updateFullscreenLyrics(this.audio.currentTime, true);
      }

      setLyricToggle(key) {
        if (typeof this[key] !== "boolean") return;
        this[key] = !this[key];
        this.saveLyricSettings();
        this.applyLyricPreferences();
        if (key === "wordByWord") {
          // 逐字开关改变渲染结构，需要重建歌词 DOM
          this.renderLyrics();
          this.renderFullscreenLyrics();
        }
        this.updateLyrics(this.audio.currentTime, true);
        this.updateFullscreenLyrics(this.audio.currentTime, true);
        this.syncLyricSettingsUI();
      }

      setLyricFontScale(v) {
        this.fontScale = v;
        this.saveLyricSettings();
        this.applyLyricPreferences();
        this.syncLyricSettingsUI();
        // 字号变化后行高改变，重新对中当前行
        this.updateLyrics(this.audio.currentTime, true);
        this.updateFullscreenLyrics(this.audio.currentTime, true);
      }

      syncLyricSettingsUI() {
        document.querySelectorAll("[data-lyric-toggle]").forEach((btn) => {
          const on = !!this[btn.dataset.lyricToggle];
          btn.classList.toggle("on", on);
          btn.setAttribute("aria-checked", String(on));
        });
        document.querySelectorAll("[data-lyric-size]").forEach((btn) => {
          btn.classList.toggle(
            "active",
            parseFloat(btn.dataset.lyricSize) === this.fontScale,
          );
        });
        document.querySelectorAll(".lyric-offset-value").forEach((el) => {
          const v = this.lyricOffset;
          el.textContent = `${v > 0 ? "+" : ""}${v.toFixed(1)}s`;
        });
      }

      initLyricSettings() {
        document.querySelectorAll(".lyric-settings-btn").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.stopPropagation();
            const pop = btn.parentElement.querySelector(
              ".lyric-settings-popover",
            );
            if (!pop) return;
            const willShow = pop.classList.contains("hidden");
            document
              .querySelectorAll(".lyric-settings-popover")
              .forEach((p) => p.classList.add("hidden"));
            if (willShow) {
              pop.classList.remove("hidden");
              if (
                btn.id === "lyric-settings-btn-tab" &&
                this.lyricsTab.classList.contains("hidden")
              )
                this.switchTab("lyrics");
            }
          });
        });
        // 点击面板外关闭
        document.addEventListener("click", (e) => {
          if (e.target.closest(".lyric-settings-host")) return;
          document
            .querySelectorAll(".lyric-settings-popover")
            .forEach((p) => p.classList.add("hidden"));
        });
        document.querySelectorAll("[data-lyric-toggle]").forEach((btn) =>
          btn.addEventListener("click", () =>
            this.setLyricToggle(btn.dataset.lyricToggle),
          ),
        );
        document.querySelectorAll("[data-lyric-size]").forEach((btn) =>
          btn.addEventListener("click", () =>
            this.setLyricFontScale(parseFloat(btn.dataset.lyricSize)),
          ),
        );
        document.querySelectorAll(".lyric-offset-minus").forEach((btn) =>
          btn.addEventListener("click", () =>
            this.setLyricOffset(this.lyricOffset - 0.5),
          ),
        );
        document.querySelectorAll(".lyric-offset-plus").forEach((btn) =>
          btn.addEventListener("click", () =>
            this.setLyricOffset(this.lyricOffset + 0.5),
          ),
        );
        document.querySelectorAll(".lyric-offset-reset").forEach((btn) =>
          btn.addEventListener("click", () => this.setLyricOffset(0)),
        );
        this.syncLyricSettingsUI();
      }

      updateLyrics(currentTime, force = false) {
        const lines = this.lyrics;
        if (!this.lyricsEl || !lines.length) return;

        // 歌词偏移：正值延后、负值提前
        currentTime -= this.lyricOffset;

        const prev = this.activeLyricIndex;
        const active = this.findLyricIndex(currentTime);
        const changed = active !== prev;

        if (changed) {
          this.activeLyricIndex = active;
          const lo = Math.max(Math.min(prev, active), 0);
          const hi = Math.max(prev, active);
          for (let i = lo; i <= hi; i++) {
            const el = lines[i]?._el;
            if (!el) continue;
            el.classList.toggle("active", i === active);
            el.classList.toggle("past", i !== active && i < active);
          }
          if (prev >= 0 && lines[prev]?._words)
            lines[prev]._words.forEach((w) => {
              w.state = "";
              w.el.classList.remove("sung", "past");
              w.el.style.setProperty("--wp", "0");
            });
        }

        // 逐字高亮只处理当前行（逐行 LRC 或关闭逐字时该数组为空）
        const words = lines[active]?._words;
        if (words)
          for (const w of words) {
            const state =
              currentTime >= w.end ? "past" : currentTime >= w.start ? "sung" : "";
            if (state !== w.state) {
              w.state = state;
              w.el.classList.toggle("sung", state === "sung");
              w.el.classList.toggle("past", state === "past");
              // 离散状态切换时重置填充进度，正在演唱的字再逐帧推进
              if (state === "past") w.el.style.setProperty("--wp", "100");
              else if (state === "") w.el.style.setProperty("--wp", "0");
            }
            if (state === "sung") {
              const p =
                w.end > w.start
                  ? (currentTime - w.start) / (w.end - w.start)
                  : 1;
              w.el.style.setProperty(
                "--wp",
                (Math.min(Math.max(p, 0), 1) * 100).toFixed(2),
              );
            }
          }

        if ((changed || force) && active >= 0) {
          if (force) {
            this.lyricsUserScrolled = false;
            clearTimeout(this.lyricsScrollTimeout);
          }
          if (this.autoScroll && !this.lyricsUserScrolled)
            this.scrollLyricsTo(this.lyricsEl, lines[active]._el, force);
        }
      }

      updateFullscreenLyrics(currentTime, force = false) {
        const lines = this.lyrics;
        if (!this.fullscreenLyricsContent || !lines.length) return;

        // 歌词偏移：正值延后、负值提前
        currentTime -= this.lyricOffset;

        const prev = this.activeFullIndex;
        const active = this.findLyricIndex(currentTime);
        const changed = active !== prev;

        if (changed) {
          this.activeFullIndex = active;
          const lo = Math.max(Math.min(prev, active), 0);
          const hi = Math.max(prev, active);
          for (let i = lo; i <= hi; i++) {
            const el = lines[i]?._fEl;
            if (!el) continue;
            el.classList.toggle("active", i === active);
            el.classList.toggle("past", i !== active && i < active);
          }
          if (prev >= 0 && lines[prev]?._fWords)
            lines[prev]._fWords.forEach((w) => {
              w.state = "";
              w.el.classList.remove("sung", "past");
              w.el.style.setProperty("--wp", "0");
            });
        }

        const line = lines[active];
        if (!line?._fEl) return;

        if (line._fWords) {
          // 逐字模式：逐字推进填充进度（--wp 由 CSS 渐变消费）
          for (const w of line._fWords) {
            const state =
              currentTime >= w.end ? "past" : currentTime >= w.start ? "sung" : "";
            if (state !== w.state) {
              w.state = state;
              w.el.classList.toggle("sung", state === "sung");
              w.el.classList.toggle("past", state === "past");
              if (state === "past") w.el.style.setProperty("--wp", "100");
              else if (state === "") w.el.style.setProperty("--wp", "0");
            }
            if (state === "sung") {
              const p =
                w.end > w.start
                  ? (currentTime - w.start) / (w.end - w.start)
                  : 1;
              w.el.style.setProperty(
                "--wp",
                (Math.min(Math.max(p, 0), 1) * 100).toFixed(2),
              );
            }
          }
        } else {
          // 卡拉OK渐变扫色：--p 为该行已唱进度百分比，由 CSS 渐变消费
          const start = line.time;
          const nextT = lines[active + 1]
            ? lines[active + 1].time
            : this.audio.duration || start + 8;
          const dur = Math.min(Math.max(nextT - start, 1), 12);
          const p = Math.min(Math.max((currentTime - start) / dur, 0), 1);
          line._fEl.style.setProperty("--p", (p * 100).toFixed(2));
        }

        if (changed || force) {
          if (force) {
            this.fsUserScrolled = false;
            clearTimeout(this.fsScrollTimeout);
          }
          if (this.autoScroll && !this.fsUserScrolled)
            this.scrollLyricsTo(this.lyricsScrollContainer, line._fEl, force);
        }
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      window.musicPlayer = new MusicPlayer();
    });
  </script>
</BaseLayout>

    .lyrics-content .lyric-line {
      display: flex;
      align-items: baseline;
      justify-content: center;
      gap: 0;
      padding: 8px 12px;
      border-radius: 8px;
      transition: color 0.15s ease;
      /* 字号随设置面板的 --lyric-font-scale 缩放 */
      font-size: calc(16px * var(--lyric-font-scale, 1));
      color: rgba(128, 128, 128, 0.5);
      cursor: pointer;
    }
    .lyrics-content .lyric-line:hover {
      color: var(--color-foreground);
    }

    .lyrics-content .lyric-line.active {
      color: var(--lyric-active-color, var(--color-foreground));
      text-shadow:
        0 0 8px var(--glow-color, rgba(58, 101, 232, 0.6)),
        0 0 20px var(--glow-color, rgba(58, 101, 232, 0.4)),
        0 0 40px var(--glow-color, rgba(58, 101, 232, 0.2));
    }
    .lyrics-content .lyric-word {
      display: inline-block;
      color: inherit;
      transform-origin: center bottom;
    }
    /* 逐字歌词：未唱字模糊，演唱字以主题色渐变填充（--wp 由 JS 逐帧写入）+ 轻微弹跳。
       transition 只放在 sung/past 上：CSS 过渡取自目标状态，行切换时整行模糊
       即时生效（一次绘制，不卡顿），仅单字唱完变清晰时平滑过渡 */
    .lyrics-content .lyric-line.active .lyric-word {
      --wp: 0;
      background-image: linear-gradient(
        90deg,
        var(--lyric-active-color, var(--color-foreground))
          calc(var(--wp) * 1%),
        rgba(128, 128, 128, 0.5) calc(var(--wp) * 1%)
      );
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
      filter: blur(1px);
    }
    .lyrics-content .lyric-line.active .lyric-word.sung,
    .lyrics-content .lyric-line.active .lyric-word.past {
      filter: blur(0);
      transition: filter 0.25s ease;
    }
    @keyframes lyric-word-pop-sm {
      0% {
        transform: scale(1);
      }
      35% {
        transform: scale(1.15);
      }
      100% {
        transform: scale(1);
      }
    }
    .lyrics-content .lyric-line.active .lyric-word.sung {
      animation: lyric-word-pop-sm 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    /* 逐字行自身已有填充动画，去掉整行发光避免文字阴影盖在渐变字上 */
    .lyrics-content .lyric-line.active.has-words,
    .dark .lyrics-content .lyric-line.active.has-words {
      text-shadow: none;
    }

    .lyrics-content .lyric-line.past {
      color: rgba(128, 128, 128, 0.5);
    }
    .lyrics-content .lyric-line.past:hover {
      color: var(--color-foreground);
    }


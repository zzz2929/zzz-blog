    /* ====== 音律条 ====== */
    /* 颜色跟随歌曲主题色（--lyric-active-color，由 JS 按页面背景计算写入），
       条以中线为轴上下律动，与渐变端点淡出呼应 */
    .waveform {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 3px;
      height: 60px;
    }
    .waveform span {
      display: block;
      width: 4px;
      border-radius: 999px;
      background: var(--lyric-active-color, #3a65e8);
      opacity: 0.7;
      animation: wave var(--dur, 1s) ease-in-out var(--del, 0s) infinite
        alternate paused;
    }
    /* CSS 动画兜底模式的节奏与高低错落（真实频谱模式下被 .real 覆盖） */
    .waveform span:nth-child(5n + 1) {
      --dur: 0.9s;
      --del: 0s;
      height: 30px;
    }
    .waveform span:nth-child(5n + 2) {
      --dur: 1.1s;
      --del: 0.08s;
      height: 20px;
    }
    .waveform span:nth-child(5n + 3) {
      --dur: 0.7s;
      --del: 0.16s;
      height: 42px;
    }
    .waveform span:nth-child(5n + 4) {
      --dur: 1.25s;
      --del: 0.05s;
      height: 16px;
    }
    .waveform span:nth-child(5n) {
      --dur: 0.95s;
      --del: 0.12s;
      height: 36px;
    }
    /* 桌面端放大音律条：加宽加高，并通过 keyframes 里的 --h 变量整体抬高振幅 */
    @media (min-width: 1024px) {
      .waveform {
        gap: 6px;
        height: 90px;
      }
      .waveform span {
        width: 6px;
        --h1: 8px;
        --h2: 66px;
        --h3: 16px;
      }
    }
    /* 真实频谱模式：JS 逐帧写高度，禁用 CSS 关键帧 */
    .waveform.real {
      position: relative;
    }
    /* 中线细线锚定条的镜像轴 */
    .waveform.real::before {
      content: "";
      position: absolute;
      left: 4%;
      right: 4%;
      top: 50%;
      height: 1px;
      background: color-mix(
        in srgb,
        var(--lyric-active-color, #3a65e8) 30%,
        transparent
      );
    }
    .waveform.real span {
      animation: none;
      opacity: 0.9;
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--lyric-active-color, #3a65e8) 30%, transparent),
        var(--lyric-active-color, #3a65e8)
      );
      box-shadow: 0 0 8px
        color-mix(in srgb, var(--lyric-active-color, #3a65e8) 30%, transparent);
      transition: height 0.12s ease-out;
    }
    @keyframes wave {
      0% {
        height: var(--h1, 6px);
        opacity: 0.25;
      }
      50% {
        height: var(--h2, 50px);
        opacity: 0.9;
      }
      100% {
        height: var(--h3, 12px);
        opacity: 0.35;
      }
    }

    .waveform span:nth-child(odd) {
      --h1: 5px;
      --h2: 48px;
      --h3: 10px;
    }
    .waveform span:nth-child(even) {
      --h1: 8px;
      --h2: 42px;
      --h3: 6px;
    }
    .waveform span:nth-child(3n) {
      --h1: 4px;
      --h2: 55px;
      --h3: 14px;
    }
  </style>

  <!-- Music Data Container -->
  <div id="music-data" style="display: none;"></div>

  <script>
    // 桥接：模块脚本打包 gsap，供下方 is:inline 播放器脚本使用
    // （模块脚本是 deferred，先于 DOMContentLoaded 执行，时序安全）
    import { gsap } from "gsap";
    window.gsap = gsap;
  </script>

  <script is:inline define:vars={{ musicDataJSON: JSON.stringify(musicData), playlistsJSON: JSON.stringify(playlists), notPlaying: t('music.notPlaying'), selectSong: t('music.selectSong'), noLyrics: t('music.noLyrics'), unknownAlbum: t('music.unknownAlbum'), storageKey: MINI_PLAYER_STORAGE_KEY, defaultVolume: siteConfig.music.defaultVolume, lyricDefaultsJSON: JSON.stringify(siteConfig.music.lyricDefaults) }}>
    window.__MUSIC_DATA__ = JSON.parse(musicDataJSON);
    window.__PLAYLISTS__ = JSON.parse(playlistsJSON);
    window.__MUSIC_T__ = {
      notPlaying: notPlaying,
      selectSong: selectSong,
      noLyrics: noLyrics,
      unknownAlbum: unknownAlbum,
      emptyPlaylist: '播放列表为空',
      removeFromList: '从列表移除',

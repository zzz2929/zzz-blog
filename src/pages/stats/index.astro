---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/astro/Header.astro";
import Footer from "@/components/astro/Footer.astro";
import { getCollection } from "astro:content";
import { useTranslations, getLocaleFromURL } from "@/i18n";
import { estimateWordCount } from "@/lib/postStats";

const locale = getLocaleFromURL(Astro.url.pathname);
const t = useTranslations(locale);
const formatNum = (n) => n.toLocaleString(locale === "en" ? "en-US" : locale);

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const totalWords = posts.reduce((sum, p) => sum + estimateWordCount(p.body ?? ""), 0);

// 按年聚合：文章数 + 字数
const yearMap = new Map<number, { count: number; words: number }>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  const entry = yearMap.get(y) ?? { count: 0, words: 0 };
  entry.count += 1;
  entry.words += estimateWordCount(p.body ?? "");
  yearMap.set(y, entry);
}
const years = [...yearMap.entries()].sort((a, b) => b[0] - a[0]);
const maxYearWords = Math.max(...years.map(([, v]) => v.words), 1);

// 热门标签 Top 8
const tagCounts = new Map<string, number>();
for (const p of posts) {
  for (const tag of p.data.tags) tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
}
const topTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);
const maxTagCount = topTags[0]?.[1] ?? 1;
---

<BaseLayout title={t("stats.title")}>
  <Header />
  <main class="mx-auto max-w-[1152px] px-4 pt-[20px] pb-[20px] sm:px-6" data-pagefind-body>
    <h1 class="mb-2 text-3xl font-bold text-foreground">📊 {t("stats.title")}</h1>
    <p class="mb-8 text-lg text-muted">{t("stats.subtitle")}</p>

    <!-- 汇总卡片 -->
    <div class="mb-10 grid gap-4 sm:grid-cols-3">
      <div class="glass-card text-center" style="border-radius: 16px; padding: 24px;">
        <p class="text-3xl font-bold text-primary">{formatNum(posts.length)}</p>
        <p class="mt-1 text-sm text-foreground-muted">{t("stats.totalPosts")}</p>
      </div>
      <div class="glass-card text-center" style="border-radius: 16px; padding: 24px;">
        <p class="text-3xl font-bold text-primary">{formatNum(totalWords)}</p>
        <p class="mt-1 text-sm text-foreground-muted">{t("stats.totalWords")}</p>
      </div>
      <div class="glass-card text-center" style="border-radius: 16px; padding: 24px;">
        <p class="text-3xl font-bold text-primary">{years.length}</p>
        <p class="mt-1 text-sm text-foreground-muted">{t("stats.yearsSpan")}</p>
      </div>
    </div>

    <!-- 年度分布 -->
    <section class="mb-10">
      <h2 class="mb-4 text-xl font-bold text-foreground">{t("stats.yearPosts")}</h2>
      <div class="glass-card" style="border-radius: 16px; padding: 20px;">
        {
          years.map(([year, v]) => (
            <div class="mb-3 flex items-center gap-3 last:mb-0">
              <span class="w-14 shrink-0 text-sm font-medium text-foreground">{year}</span>
              <div class="h-5 flex-1 overflow-hidden rounded-full bg-foreground/5">
                <div
                  class="h-full rounded-full"
                  style={`width: ${Math.max(2, (v.words / maxYearWords) * 100)}%; background: linear-gradient(90deg, var(--color-primary), var(--color-accent));`}
                />
              </div>
              <span class="w-40 shrink-0 text-right text-xs text-foreground-muted">
                {t("stats.postsUnit").replace("{count}", String(v.count))} · {formatNum(v.words)} {t("stats.wordsUnit")}
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 热门标签 -->
    <section>
      <h2 class="mb-4 text-xl font-bold text-foreground">{t("stats.topTags")}</h2>
      <div class="flex flex-wrap gap-3">
        {
          topTags.map(([tag, count]) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}/`}
              class="glass-card flex items-baseline gap-2 rounded-full px-4 py-2 transition-transform hover:-translate-y-0.5"
              style={`font-size: ${0.85 + (count / maxTagCount) * 0.5}rem;`}
            >
              <span class="font-semibold text-foreground">#{tag}</span>
              <span class="text-xs text-foreground-muted">{count}</span>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

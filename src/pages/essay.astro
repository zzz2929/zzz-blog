---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/astro/Header.astro";
import Footer from "@/components/astro/Footer.astro";
import Comments from "@/components/astro/Comments.astro";
import EssayCard from "@/components/astro/EssayCard.astro";

import { useTranslations, getLocaleFromURL } from "@/i18n";

const locale = getLocaleFromURL(Astro.url.pathname);
const t = useTranslations(locale);
const essayData = await getCollection("essay");
const essay = essayData[0]?.data;
const TL_COLORS = ["#22c55e", "#06b6d4", "#3b82f6", "#ec4899", "#d97706", "#ef4444", "#f97316", "#eab308"];

// Group essays by day (date format: "YYYY-MM-DD HH:MM:SS"), then sort each
// day chronologically by the full timestamp (earliest first)
const itemsByDay = new Map();
for (const item of essay?.essay_list ?? []) {
  const day = (item.date || "").slice(0, 10);
  if (!itemsByDay.has(day)) itemsByDay.set(day, []);
  itemsByDay.get(day).push(item);
}
const dayGroups = [...itemsByDay].map(([date, items]) => ({ date, items }));
for (const group of dayGroups) {
  group.items.sort((a, b) => (a.date || "").localeCompare(b.date || ""));
  // 每行固定 4 个节点；奇数行方向反转，形成蛇形时间轴
  group.tlRows = [];
  for (let i = 0; i < group.items.length; i += 4) {
    group.tlRows.push(
      group.items.slice(i, i + 4).map((item, j) => ({
        item,
        color: TL_COLORS[(i + j) % TL_COLORS.length],
      })),
    );
  }
}
// 多条随笔的时间轴节点配色（参照 uiverse 时间轴样式轮换）

---

<BaseLayout title={t('essay.title')}>
  <Header />
  <main class="mx-auto max-w-[1152px] px-4 pt-[20px] pb-[20px] sm:px-6">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-foreground">
        {essay?.title || t('essay.fallbackTitle')}
      </h1>
      {essay?.subTitle && <p class="mt-2 text-muted">{essay.subTitle}</p>}
      {
        essay?.tips && (
          <p class="mt-1 text-sm text-muted italic">{essay.tips}</p>
        )
      }
    </div>

    <div class="relative border-l-2 border-border pl-6">
      {
        dayGroups.map((group) => (
          <div id={`essay-${group.date}`} class="mb-8 relative">
            <span
              class="absolute -left-[33px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-primary"
              style="background: linear-gradient(135deg, rgba(255,255,255,0.4), rgba(255,255,255,0.1)); backdrop-filter: blur(20px);"
            />
            <time class="text-xs text-muted">{group.date}</time>
            {group.items.length > 1 ? (
              <div class="essay-tl mt-2">
                {group.tlRows.map((row, r) => (
                  <div class:list={["essay-tl-row", { rtl: r % 2 === 1 }]}>
                    {row.map(({ item, color }) => (
                      <div
                        class="essay-tl-item"
                        style={`--tl-color: ${color}`}
                      >
                        <div class="essay-tl-time">
                          {item.date.slice(11, 16) === "00:00" ? " " : item.date.slice(11, 16)}
                        </div>
                        <div class="essay-tl-node" />
                        <EssayCard
                          item={item}
                          imgWidth="100%"
                          borderColor="color-mix(in srgb, var(--tl-color) 55%, transparent)"
                        />
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            ) : (
              <div class="mt-2">
                {group.items.map((item) => (
                  <EssayCard item={item} imgWidth="auto" class="w-fit max-w-[460px]" />
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>

    {
      essay?.buttonText && essay?.buttonLink && (
        <div class="mt-8 text-center">
          <a
            href={essay.buttonLink}
            class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 text-white hover:bg-primary-light transition-colors"
          >
            {essay.buttonText}
          </a>
        </div>
      )
    }
  </main>

  <div class="mx-auto max-w-[1152px] px-4 sm:px-6">
    <Comments />
  </div>

  <Footer />
</BaseLayout>

<style>
  @keyframes essay-highlight {
    0% { background: rgba(66, 90, 239, 0.15); }
    100% { background: transparent; }
  }
  [id^="essay-"]:target {
    scroll-margin-top: 80px;
    animation: essay-highlight 2s ease-out;
    border-radius: 12px;
  }

  /* ====== 同日多条随笔的蛇形时间轴（每行 4 节点，奇偶行反向） ====== */
  .essay-tl {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* 与单条随笔卡片左对齐 */
    gap: 28px;
  }
  .essay-tl-row {
    position: relative;
    display: flex;
    justify-content: flex-start;
    gap: 24px;
    width: 1032px; /* 4 × 240 卡片 + 3 × 24 间距，保证奇偶行节点纵向对齐 */
    max-width: 100%;
  }
  .essay-tl-row.rtl {
    flex-direction: row-reverse;
    justify-content: flex-start; /* row-reverse 的主轴起点在右侧，从右往左排 */
  }
  .essay-tl-item {
    position: relative;
    width: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .essay-tl-time {
    height: 20px;
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
    color: var(--color-foreground);
  }
  .essay-tl-node {
    width: 20px;
    height: 20px;
    margin: 4px 0 6px;
    border-radius: 50%;
    border: 6px solid var(--tl-color);
    background: var(--color-foreground);
    box-sizing: border-box;
  }
  /* 行内相邻节点：连线 + 箭头（节点中心间距 264px，几何固定） */
  .essay-tl-row:not(.rtl) .essay-tl-item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 33px;
    left: 136px;
    width: 232px;
    height: 2px;
    background: #9ca3af;
  }
  .essay-tl-row.rtl .essay-tl-item:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 33px;
    right: 136px;
    width: 232px;
    height: 2px;
    background: #9ca3af;
  }
  /* 行间衔接：本行最后一个节点沿外侧圆角拐弯，进入下一行首个节点 */
  .essay-tl-row:not(.rtl):not(:last-child)::after {
    content: "";
    position: absolute;
    top: 33px;
    left: 928px;
    right: -13px;
    bottom: -61px;
    border-top: 2px solid #9ca3af;
    border-right: 2px solid #9ca3af;
    border-bottom: 2px solid #9ca3af;
    border-top-right-radius: 24px;
    border-bottom-right-radius: 24px;
  }
  .essay-tl-row.rtl:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 33px;
    right: 928px;
    left: -13px;
    bottom: -61px;
    border-top: 2px solid #9ca3af;
    border-left: 2px solid #9ca3af;
    border-bottom: 2px solid #9ca3af;
    border-top-left-radius: 24px;
    border-bottom-left-radius: 24px;
  }
  /* 全站 zoom 等比缩放下，1032px 的行在任何桌面视口都等比放得下，无需中途退化；
     仅在移动端（zoom=1 的区间）保留换行退化 */
  @media (max-width: 767px) {
    /* 视口放不下固定 4 列时退化为普通换行，隐藏行间衔接 */
    .essay-tl-row {
      flex-wrap: wrap;
      justify-content: flex-start;
      row-gap: 28px;
    }
    .essay-tl-row.rtl {
      justify-content: flex-end; /* row-reverse 主轴起点在右，flex-end 才是靠左 */
    }
    .essay-tl-row::after,
    .essay-tl-row::before {
      display: none;
    }
  }
  @media (max-width: 639px) {
    .essay-tl-row .essay-tl-item::after,
    .essay-tl-row .essay-tl-item::before {
      display: none;
    }
  }
</style>

<script>
  import { initImageFancybox } from '@/lib/fancybox';

  // 每天的图片各自成组，灯箱内只浏览当天图片，减少幻灯片与缩略图开销
  function initEssayFancybox() {
    document.querySelectorAll("main [id^='essay-']").forEach((day) => {
      initImageFancybox(day.id, `#${day.id}`);
    });
  }

  initEssayFancybox();

  // 单图卡片宽度随图片自适应（左对齐时间轴），避免图片两侧大面积留白；多图卡片保持满宽
  function fitCardWidths() {
    document.querySelectorAll("main [id^='essay-'] .essay-card").forEach((card) => {
      const imgs = card.querySelectorAll('img');
      if (imgs.length !== 1) return;
      const img = imgs[0];
      // 只适配 width:auto 的图片（单条/瀑布流卡片）；时间轴卡片 width:100%，跳过
      if (img.style.width !== 'auto') return;
      if (!img.complete || !img.naturalWidth) return;
      // zoom 等比缩放下 rect 返回视觉像素，style.width 是布局像素，需除以 zoom
      const zoom = parseFloat(getComputedStyle(document.documentElement).zoom) || 1;
      const w = Math.ceil(img.getBoundingClientRect().width / zoom);
      if (w > 0) {
        card.style.width = `${w + 34}px`; // p-4 内边距 + 边框
        card.style.maxWidth = '100%'; // 不超出瀑布流列宽
      }
    });
  }
  let fitScheduled = false;
  function scheduleFit() {
    if (fitScheduled) return;
    fitScheduled = true;
    requestAnimationFrame(() => {
      fitScheduled = false;
      fitCardWidths();
    });
  }
  const imgResizeObserver = new ResizeObserver(scheduleFit);
  function bindFitTriggers() {
    document.querySelectorAll("main [id^='essay-'] .essay-card img").forEach((img) => {
      if (img.dataset.fitBound) return;
      img.dataset.fitBound = '1';
      imgResizeObserver.observe(img);
    });
  }
  window.addEventListener('resize', scheduleFit);
  bindFitTriggers();
  fitCardWidths();
</script>

---
import ThemeToggle from "@/components/react/ThemeToggle.tsx";
import { useTranslations, getLocaleFromURL } from "@/i18n";
import type { Locale } from "@/i18n";
import { siteConfig } from "@/config/site";

// Navigation SVGs inlined at build time (virtual module from astro.config.mjs)
import iconMap from 'virtual:nav-svgs';

const locale = getLocaleFromURL(Astro.url.pathname) as Locale;
const t = useTranslations(locale);
const prefix = locale === "zh-CN" ? "" : `/${locale}`;

// Keep the current page when switching languages: strip the active locale
// prefix to get the canonical (zh-CN) path, then re-add the target prefix.
const basePath =
  prefix && Astro.url.pathname.startsWith(prefix)
    ? Astro.url.pathname.slice(prefix.length) || "/"
    : Astro.url.pathname;
const switchLocaleHref = (target: Locale) =>
  target === "zh-CN" ? basePath : `/${target}${basePath}`;

// 「站点切换」外链列表在 src/config/site.ts（siteLinks）中维护
const siteLinks = siteConfig.siteLinks;

// 当前页高亮（移动端磁贴）：与导航 href 规范化比较（忽略末尾斜杠）
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) =>
  (href.replace(/\/+$/, "") || "/") === currentPath;

// 顶部导航菜单在 src/config/site.ts（nav.menu）中维护；
// label/name 支持 i18n key 或文字，href 自动带上语言前缀
const menuItems = siteConfig.nav.menu.map((item) => ({
  label: t(item.label),
  children: item.children.map((child) => ({
    ...child,
    name: t(child.name),
    href: `${prefix}${child.href}`,
  })),
}));


function isImageIcon(icon) {
  return (
    icon.startsWith("http") ||
    icon.startsWith("/") ||
    icon.endsWith(".svg") ||
    icon.endsWith(".png") ||
    icon.endsWith(".jpg") ||
    icon.endsWith(".jpeg") ||
    icon.endsWith(".gif") ||
    icon.endsWith(".webp")
  );
}

---

<header
  class="site-header fixed left-0 right-0 transition-all duration-300"
  id="site-header"
  style="top: 10px; padding: 0 16px; z-index: 9999;"
>
  <div class="mx-auto" style="max-width: 1318px;">
    <div
      class="header-bar flex items-center justify-between px-4 sm:px-6 rounded-full glass-card-strong max-md:hidden"
      style="height: var(--header-height); box-shadow: 0 1px 24px rgba(0,0,0,0.1); overflow: visible !important"
    >
      <div class="flex items-center gap-1 shrink-0">
        <!-- Site switcher -->
        <div class="site-switcher relative group">
          <button
            class="switcher-btn flex items-center justify-center rounded-xl transition-all duration-300 glass-card-strong"
            aria-label={t("nav.siteNav")}
            style="width: 38px; height: 38px; color: var(--color-foreground-muted)"
          >
            <svg
              class="transition-transform duration-300"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <circle cx="5" cy="12" r="1.5"></circle><circle
                cx="12"
                cy="12"
                r="1.5"></circle><circle cx="19" cy="12" r="1.5"></circle>
            </svg>
          </button>
          <div
            class="site-switcher-dropdown absolute left-0 top-full mt-2 p-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 glass-card-strong"
            style="z-index: 99999; width: max-content; max-width: calc(100vw - 32px); border-radius: 14px; box-shadow: 0 8px 32px rgba(0,0,0,0.12)"
          >
            <div class="grid grid-cols-[repeat(2,auto)] gap-1">
              {
                siteLinks.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 px-3 py-2.5 rounded-lg whitespace-nowrap transition-all duration-200 hover:bg-foreground/5"
                    style="font-size: 16px; font-weight: 700; color: var(--color-foreground);"
                  >
                    {isImageIcon(link.icon) ? (
                      <img
                        src={link.icon}
                        alt={link.name}
                        style="width: 20px; height: 20px; object-fit: contain;"
                      />
                    ) : (
                      <span class="text-base">{link.icon}</span>
                    )}
                    <span>{link.name}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Logo -->
        <a
          href={`${prefix}/`}
          class="logo-box group relative ml-1 flex items-center overflow-hidden rounded-xl cursor-pointer glass-card-strong"
          aria-label={t("nav.home")}
          style="width: 112px; height: 38px; transition: border-color 0.5s ease-in-out, box-shadow 0.5s ease-in-out"
        >
          <span
            class="logo-icon absolute inset-y-0 left-0 z-10 flex items-center justify-center transition-all duration-500 ease-in-out"
            style="width: 38px;"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="color: #425aef; transition: transform 0.5s ease, stroke 0.5s ease;"
            >
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </span>
          <span
            class="logo-text relative z-10 flex h-full w-full items-center text-sm font-bold whitespace-nowrap overflow-hidden transition-all duration-500 ease-in-out"
            style="color: #425aef; padding-left: 44px; padding-right: 10px;"
          >
            {siteConfig.title}
          </span>
        </a>
      </div>

      <!-- Center nav -->
      <nav
        class="hidden md:flex items-center gap-0.5"
        style="position: absolute; left: 50%; transform: translateX(-50%);"
      >
        {
          menuItems.map((item) => (
            <div class="nav-item relative">
              <button
                class="nav-trigger flex items-center gap-1 rounded-lg px-3 py-2 transition-colors"
                style="font-size: 16px; font-weight: 700; color: var(--color-foreground);"
              >
                {item.label}
                <svg
                  class="h-3 w-3 transition-transform duration-200 nav-arrow"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </button>
              <div
                class="nav-dropdown glass-card-strong"
                style="position: fixed; z-index: 99999; opacity: 0; visibility: hidden; pointer-events: none; border-radius: 16px; box-shadow: 0 12px 40px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.06); padding: 6px; white-space: nowrap; transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;"
              >
                <div class="nav-dropdown-inner flex items-center gap-0.5">
                  {item.children.map((child, ci) => (
                    <a
                      href={child.href}
                      class="nav-dropdown-item flex items-center gap-2.5 rounded-[10px] px-3 py-2 whitespace-nowrap transition-all duration-200"
                      style={`font-size: 15px; font-weight: 600; color: var(--color-foreground); opacity: 0; transform: translateY(6px); transition-delay: ${ci * 30}ms;`}
                    >
                      {iconMap[child.icon] ? (
                        <Fragment set:html={iconMap[child.icon].replace(/width="[^"]*"/, 'width="18"').replace(/height="[^"]*"/, 'height="18"')} />
                      ) : isImageIcon(child.icon) ? (
                        <img
                          src={child.icon}
                          alt={child.name}
                          style="width: 18px; height: 18px; display: block; flex-shrink: 0;"
                        />
                      ) : (
                        <span class="text-base">{child.icon}</span>
                      )}
                      <span>{child.name}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </nav>

      <!-- Right side -->
      <div class="flex items-center gap-1.5 shrink-0">
        <!-- Search：输入即搜,结果在下方弹出 -->
        <div class="header-search relative">
          <div class="header-search-box glass-card-strong">
            <svg
              class="search-icon"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#425aef"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="flex-shrink: 0; transition: stroke 0.3s ease;"
            >
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.2" y2="16.2"></line>
            </svg>
            <input
              id="header-search-input"
              type="text"
              autocomplete="off"
              spellcheck="false"
              placeholder={t("nav.search")}
              aria-label={t("nav.search")}
            />
          </div>
          <div
            id="header-search-panel"
            class="header-search-panel glass-card-strong"
            data-empty={t("search.empty")}
            data-no-index={t("search.noIndex")}
          ></div>
        </div>
        <!-- Settings -->
        <div class="settings-menu relative group">
          <button
            class="settings-btn glass-card-strong"
            aria-label={t("nav.settings")}
            title={t("nav.settings")}
            style="display: flex; justify-content: center; align-items: center; padding: 6px 12px; gap: 8px; height: 36px; border-radius: 20px; cursor: pointer; transition: all 0.3s ease"
          >
            <svg
              class="settings-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#425aef"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="transition: transform 0.3s ease;"
            >
              <circle cx="12" cy="12" r="3"></circle>
              <path
                d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06A1.65 1.65 0 0019.32 9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"
              ></path>
            </svg>
            <span
              style="line-height: 20px; font-size: 14px; color: #425aef; font-family: sans-serif; letter-spacing: 1px;"
              >{t("nav.settings")}</span
            >
          </button>
          <div
            class="settings-dropdown absolute right-0 top-full mt-2 p-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 glass-card-strong"
            style="z-index: 99999; border-radius: 14px; box-shadow: 0 8px 32px rgba(0,0,0,0.12)"
          >
            <div class="flex items-center justify-between mb-3">
              <span
                style="font-size: 16px; font-weight: 700; color: var(--color-foreground);"
                >{t("nav.darkMode")}</span
              >
              <ThemeToggle client:only="react" locale={locale} />
            </div>
            <div
              style="height: 1px; background: var(--color-border); margin-bottom: 12px;"
            >
            </div>
            <!-- Monet palette selector -->
            <div class="mb-3">
              <span
                class="block mb-2"
                style="font-size: 16px; font-weight: 700; color: var(--color-foreground);"
                >{t("nav.bgColor")}</span
              >
              <div class="container-items monet-grid">
                <button
                  class="item-color"
                  data-color="var(--monet-1)"
                  aria-color="云端漫步"
                  title="云端漫步"
                  style="--color: var(--monet-1);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-2)"
                  aria-color="睡莲"
                  title="睡莲"
                  style="--color: var(--monet-2);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-3)"
                  aria-color="日出印象"
                  title="日出印象"
                  style="--color: var(--monet-3);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-4)"
                  aria-color="干草堆"
                  title="干草堆"
                  style="--color: var(--monet-4);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-5)"
                  aria-color="紫藤"
                  title="紫藤"
                  style="--color: var(--monet-5);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-6)"
                  aria-color="鲁昂大教堂"
                  title="鲁昂大教堂"
                  style="--color: var(--monet-6);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-7)"
                  aria-color="塞纳河"
                  title="塞纳河"
                  style="--color: var(--monet-7);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-8)"
                  aria-color="纯白"
                  title="纯白"
                  style="--color: var(--monet-8);"></button>
              </div>
            </div>
            {siteConfig.features.effects.enable && (
            <Fragment>
            <div
              style="height: 1px; background: var(--color-border); margin-bottom: 12px;"
            >
            </div>
            <div class="mb-3">
              <span
                class="block mb-2"
                style="font-size: 16px; font-weight: 700; color: var(--color-foreground);"
                >{t("nav.customEffects")}</span
              >
              <div class="flex items-center justify-between mb-3">
                <span style="font-size: 14px; color: var(--color-foreground);"
                  >{t("effects.trail")}</span
                >
                <button
                  type="button"
                  class="custom-ui-switch effects-trail-toggle"
                  role="switch"
                  aria-checked="true"
                  aria-label={t("effects.trail")}
                ></button>
              </div>
              <div class="flex items-center justify-between">
                <span style="font-size: 14px; color: var(--color-foreground);"
                  >{t("effects.click")}</span
                >
                <button
                  type="button"
                  class="custom-ui-switch effects-click-toggle"
                  role="switch"
                  aria-checked="true"
                  aria-label={t("effects.click")}
                ></button>
              </div>
            </div>
            </Fragment>
            )}
            {siteConfig.features.contextMenu.enable && (
            <Fragment>
            <div
              style="height: 1px; background: var(--color-border); margin-bottom: 12px;"
            >
            </div>
            <div class="flex items-center justify-between mb-3">
              <span
                style="font-size: 16px; font-weight: 700; color: var(--color-foreground);"
                >{t("nav.customContextMenu")}</span
              >
              <button
                type="button"
                class="custom-ui-switch context-menu-toggle"
                role="switch"
                aria-checked="true"
                aria-label={t("nav.customContextMenu")}
              ></button>
            </div>
            </Fragment>
            )}
            {siteConfig.features.i18n.enable && (
            <div
              style="height: 1px; background: var(--color-border); margin-bottom: 12px;"
            >
            </div>
            <div class="flex items-center justify-between">
              <span
                style="font-size: 16px; font-weight: 700; color: var(--color-foreground);"
                >{t("nav.langSwitch")}</span
              >
              <div class="flex gap-1">
                <a
                  href={switchLocaleHref("zh-CN")}
                  class:list={[
                    "px-2 py-1 rounded text-xs font-medium transition-colors",
                    locale === "zh-CN"
                      ? "bg-[var(--color-primary)] text-white"
                      : "",
                  ]}
                  style={locale !== "zh-CN"
                    ? "border: 1px solid var(--color-border); color: var(--color-foreground-muted);"
                    : ""}>简</a
                >
                <a
                  href={switchLocaleHref("zh-TW")}
                  class:list={[
                    "px-2 py-1 rounded text-xs font-medium transition-colors",
                    locale === "zh-TW"
                      ? "bg-[var(--color-primary)] text-white"
                      : "",
                  ]}
                  style={locale !== "zh-TW"
                    ? "border: 1px solid var(--color-border); color: var(--color-foreground-muted);"
                    : ""}>繁</a
                >
                <a
                  href={switchLocaleHref("en")}
                  class:list={[
                    "px-2 py-1 rounded text-xs font-medium transition-colors",
                    locale === "en"
                      ? "bg-[var(--color-primary)] text-white"
                      : "",
                  ]}
                  style={locale !== "en"
                    ? "border: 1px solid var(--color-border); color: var(--color-foreground-muted);"
                    : ""}>En</a
                >
              </div>
            </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Spacer for fixed header（移动端高度见样式表 .header-spacer） -->
<div class="header-spacer"></div>

<!-- ===== 移动端顶栏（<1024px）：通栏 App Bar，替代 PC 悬浮胶囊条 ===== -->
<div class="m-bar">
  <a href={`${prefix}/`} class="m-logo" aria-label={t("nav.home")}>
    <svg
      width="21"
      height="21"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </svg>
    <span>{siteConfig.title}</span>
  </a>
  <div class="m-actions">
    <button class="m-icon-btn m-btn-search" aria-label={t("nav.search")}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.2" y2="16.2"></line>
      </svg>
    </button>
    <button class="m-icon-btn m-btn-theme" aria-label={t("nav.darkMode")}>
      <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
      <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
      </svg>
    </button>
    <button
      class="m-icon-btn m-btn-menu"
      aria-label={t("nav.menu")}
      aria-expanded="false"
      aria-controls="m-sheet"
    >
      <svg class="icon-burger" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="icon-x" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</div>

<!-- ===== 移动端全屏菜单面板（<1024px）：搜索 + 磁贴导航 + 站点 + 设置 ===== -->
<div id="m-sheet" role="dialog" aria-modal="true" aria-label={t("nav.menu")}>
  <div class="m-scrim"></div>
  <div class="m-panel">
    <div class="m-panel-inner">
      <div class="m-search header-search m-anim" style="--i:0">
        <div class="header-search-box glass-card-strong">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#425aef"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="flex-shrink: 0;"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.2" y2="16.2"></line>
          </svg>
          <input
            type="text"
            autocomplete="off"
            spellcheck="false"
            placeholder={t("nav.search")}
            aria-label={t("nav.search")}
          />
        </div>
        <div
          class="header-search-panel glass-card-strong"
          data-empty={t("search.empty")}
          data-no-index={t("search.noIndex")}
        ></div>
      </div>

      {
        menuItems.map((item, gi) => (
          <section class="m-group m-anim" style={`--i:${gi + 1}`}>
            <div class="m-group-label">{item.label}</div>
            <div class="m-tiles">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class:list={[
                    "m-tile",
                    isCurrent(child.href) && "m-active",
                    item.children.length === 1 && "m-wide",
                  ]}
                >
                  {iconMap[child.icon] ? (
                    <Fragment set:html={iconMap[child.icon].replace(/width="[^"]*"/, 'width="22"').replace(/height="[^"]*"/, 'height="22"')} />
                  ) : isImageIcon(child.icon) ? (
                    <img
                      src={child.icon}
                      alt={child.name}
                      style="width: 22px; height: 22px; object-fit: contain;"
                    />
                  ) : (
                    <span>{child.icon}</span>
                  )}
                  <span>{child.name}</span>
                </a>
              ))}
            </div>
          </section>
        ))
      }

      <section class="m-group m-anim" style="--i:5">
        <div class="m-group-label">{t("nav.siteNav")}</div>
        <div class="m-sites">
          {
            siteLinks.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="m-site"
              >
                {isImageIcon(link.icon) ? (
                  <img src={link.icon} alt={link.name} loading="lazy" />
                ) : (
                  <span class="m-site-emoji">{link.icon}</span>
                )}
                <span>{link.name}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="m-group m-anim" style="--i:6">

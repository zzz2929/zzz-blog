<script is:inline>
  // 设置 / 站点切换：点击展开，两者互斥，点外部收起。
  // touch-open 的显示样式只在无 hover 的触屏设备生效（见样式表），
  // 桌面 hover 设备上点击添加的类无视觉效果，仍由 group-hover 接管。
  // （移动端 <1024 不显示这两个入口，走全屏菜单面板，见下方移动端脚本）
  (function () {
    const menus = [
      {
        menu: document.querySelector(".settings-menu"),
        btn: document.querySelector(".settings-btn"),
        dropdown: document.querySelector(".settings-dropdown"),
      },
      {
        menu: document.querySelector(".site-switcher"),
        btn: document.querySelector(".switcher-btn"),
        dropdown: document.querySelector(".site-switcher-dropdown"),
      },
    ];
    menus.forEach(({ menu, btn, dropdown }) => {
      if (!menu || !btn || !dropdown) return;
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const opening = !dropdown.classList.contains("touch-open");
        // 互斥：关闭其他下拉面板
        menus.forEach((other) => {
          if (other.dropdown !== dropdown)
            other.dropdown.classList.remove("touch-open");
        });
        dropdown.classList.toggle("touch-open");
      });
      document.addEventListener("click", (e) => {
        if (!menu.contains(e.target))
          dropdown.classList.remove("touch-open");
      });
    });
  })();

  // Scroll effect: shrink shadow on scroll
  (function () {
    const h = document.getElementById("site-header");
    if (!h) return;
    let t = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!t) {
          requestAnimationFrame(() => {
            const inner = h.querySelector(".header-bar");
            if (inner) {
              inner.style.boxShadow =
                window.scrollY > 20
                  ? "0 4px 20px rgba(0,0,0,0.1)"
                  : "0 2px 12px rgba(0,0,0,0.06)";
            }
            t = false;
          });
          t = true;
        }
      },
      { passive: true },
    );
  })();

  // Monet palette switcher (light mode only)
  // View Transitions 换页后 header 是全新 DOM，本内联脚本不会重跑，
  // 必须监听 astro:page-load 重新初始化（与搜索脚本同一模式），
  // 否则换页后色块无事件、已存背景色也不恢复。
  (function () {
    // 注意：is:inline 脚本原样输出、不走 TS 编译，这里必须用纯 JS 写法
    const paletteState = (window.__monetPalette = window.__monetPalette || {});

    function isDark() {
      return document.documentElement.classList.contains("dark");
    }

    // swatch 传的是 var(--monet-N)，计算边框色时需要解析成实际 hex
    function resolveColor(color) {
      if (!color.startsWith("var(")) return color;
      return (
        getComputedStyle(document.documentElement)
          .getPropertyValue(color.slice(4, -1).trim())
          .trim() || "#EDE8DE"
      );
    }

    function applyPalette(color, swatches, grids) {
      paletteState.stored = color; // 同步状态，深色模式切换回切时才能恢复用户选的颜色
      if (isDark()) {
        // Dark mode: remove inline background, let CSS starfield take over
        document.body.style.background = "";
        document.documentElement.style.setProperty(
          "--color-border",
          "rgba(255,255,255,0.08)",
        );
        // PC 下拉与移动端面板里各有一份色板（.monet-grid），一并置灰
        grids.forEach((g) => {
          g.style.opacity = "0.4";
        });
        swatches.forEach((s) => {
          s.style.pointerEvents = "none";
        });
        return;
      }
      // Light mode: apply Monet palette
      grids.forEach((g) => {
        g.style.opacity = "1";
      });
      swatches.forEach((s) => {
        s.style.pointerEvents = "auto";
      });
      document.body.style.background = color;
      localStorage.setItem("monet-bg", color);
      // Match border color
      const hex = resolveColor(color);
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      document.documentElement.style.setProperty(
        "--color-border",
        `rgb(${Math.max(0, r - 15)}, ${Math.max(0, g - 15)}, ${Math.max(0, b - 15)})`,
      );
      swatches.forEach((s) => {
        s.classList.toggle("selected", s.dataset.color === color);
      });
    }

    function initMonetPalette() {
      const swatches = Array.from(document.querySelectorAll(".item-color"));
      const grids = document.querySelectorAll(".monet-grid");
      if (!swatches.length) return;

      applyPalette(
        localStorage.getItem("monet-bg") || "var(--monet-1)",
        swatches,
        grids,
      );

      swatches.forEach((swatch) => {
        if (swatch.__monetBound) return;
        swatch.__monetBound = true;
        swatch.addEventListener("click", () => {
          if (isDark()) return;
          applyPalette(swatch.dataset.color, swatches, grids);
        });
      });

      // 换页后 documentElement 保留、旧 observer 仍指向已替换的旧 swatches，需断开重建
      if (paletteState.observer) paletteState.observer.disconnect();
      const observer = new MutationObserver(() => {
        applyPalette(
          paletteState.stored ||
            localStorage.getItem("monet-bg") ||
            "var(--monet-1)",
          document.querySelectorAll(".item-color"),
          document.querySelectorAll(".monet-grid"),
        );
      });
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
      });
      paletteState.observer = observer;
    }

    initMonetPalette();
    // astro:page-load 首次加载与每次换页都会触发（换页后 header 是全新 DOM）
    if (!window.__monetPageLoadBound) {
      window.__monetPageLoadBound = true;
      document.addEventListener("astro:page-load", initMonetPalette);
    }
  })();
</script>

<script is:inline>
  // 自定义鼠标特效开关 & 右键菜单开关（localStorage 持久化，与 src/lib/customUI.ts 联动）
  (function () {
    const LS_FX_TRAIL = "effects-trail";
    const LS_FX_CLICK = "effects-click";
    const LS_CTX = "context-menu";

    function initCustomSettings() {
      // 拖尾 / 点击动效开关（PC 下拉与移动端面板各一份，按 class 绑定全部实例）
      [
        [".effects-trail-toggle", LS_FX_TRAIL, "trail"],
        [".effects-click-toggle", LS_FX_CLICK, "click"],
      ].forEach(function (row) {
        document.querySelectorAll(row[0]).forEach(function (btn) {
          const on = localStorage.getItem(row[1]) !== "off";
          btn.setAttribute("aria-checked", on ? "true" : "false");
          btn.classList.toggle("on", on);
          if (btn.__uiBound) return;
          btn.__uiBound = true;
          btn.addEventListener("click", function () {
            const next = btn.getAttribute("aria-checked") !== "true";
            // 同步所有实例（两处开关视觉状态保持一致）
            document.querySelectorAll(row[0]).forEach(function (b) {
              b.setAttribute("aria-checked", next ? "true" : "false");
              b.classList.toggle("on", next);
            });
            localStorage.setItem(row[1], next ? "on" : "off");
            if (window.__customUI && window.__customUI.setEffects) {
              const patch = {};
              patch[row[2]] = next;
              window.__customUI.setEffects(patch);
            }
          });
        });
      });

      document.querySelectorAll(".context-menu-toggle").forEach(function (btn) {
        const on = localStorage.getItem(LS_CTX) !== "off";
        btn.setAttribute("aria-checked", on ? "true" : "false");
        btn.classList.toggle("on", on);
        if (btn.__uiBound) return;
        btn.__uiBound = true;
        btn.addEventListener("click", function () {
          const next = btn.getAttribute("aria-checked") !== "true";
          document.querySelectorAll(".context-menu-toggle").forEach(function (b) {
            b.setAttribute("aria-checked", next ? "true" : "false");
            b.classList.toggle("on", next);
          });
          localStorage.setItem(LS_CTX, next ? "on" : "off");
          if (window.__customUI) window.__customUI.setContextMenuEnabled(next);
        });
      });
    }

    initCustomSettings();
    // astro:page-load 首次加载与每次换页都会触发（换页后 header 是全新 DOM）
    if (!window.__customSettingsPL) {
      window.__customSettingsPL = true;
      document.addEventListener("astro:page-load", initCustomSettings);
    }
  })();

  // Nav dropdown — 移到 body 层，让 backdrop-filter 采样真实页面内容而非顶栏已渲染层
  (function () {
    function initNavDropdowns() {
      document.querySelectorAll(".nav-item").forEach(function (item) {
        var trigger = item.querySelector(".nav-trigger");
        var dropdown = item.querySelector(".nav-dropdown");
        if (!trigger || !dropdown || dropdown.__moved) return;
        dropdown.__moved = true;
        document.body.appendChild(dropdown);

        function getZoom() {
          var z = parseFloat(getComputedStyle(document.documentElement).zoom);
          return isNaN(z) || z === 0 ? 1 : z;
        }
        function show() {
          var zoom = getZoom();
          var rect = trigger.getBoundingClientRect();
          dropdown.style.left = (rect.left + rect.width / 2) / zoom + "px";
          dropdown.style.top = (rect.bottom + 8) / zoom + "px";
          dropdown.style.transform = "translateX(-50%) translateY(0)";
          dropdown.style.opacity = "1";
          dropdown.style.visibility = "visible";
          dropdown.style.pointerEvents = "auto";
          dropdown.querySelectorAll(".nav-dropdown-item").forEach(function (el) {
            el.style.opacity = "1";
            el.style.transform = "translateY(0)";
          });
        }
        function hide() {
          dropdown.style.opacity = "0";
          dropdown.style.visibility = "hidden";
          dropdown.style.pointerEvents = "none";
          dropdown.style.transform = "translateX(-50%) translateY(8px)";
          dropdown.querySelectorAll(".nav-dropdown-item").forEach(function (el) {
            el.style.opacity = "0";
            el.style.transform = "translateY(6px)";
          });
        }
        item.addEventListener("mouseenter", show);
        item.addEventListener("mouseleave", hide);
        dropdown.addEventListener("mouseenter", show);
        dropdown.addEventListener("mouseleave", hide);
        window.addEventListener("scroll", hide, { passive: true });
      });
    }
    initNavDropdowns();
    document.addEventListener("astro:page-load", initNavDropdowns);
  })();
</script>

<script is:inline>
  // ===== 移动端顶栏 + 全屏菜单（<1024px）=====
  // View Transitions 换页后 bar/panel 是全新 DOM：astro:page-load 重新绑元素事件；
  // window/document 级监听用守卫只绑一次，回调里实时查询当前 DOM。
  (function () {
    function mOpen(focusSearch) {
      var sheet = document.getElementById("m-sheet");
      var bar = document.querySelector(".m-bar");
      if (!sheet || !bar) return;
      sheet.classList.add("open");
      bar.classList.add("m-open");
      var menuBtn = bar.querySelector(".m-btn-menu");
      if (menuBtn) menuBtn.setAttribute("aria-expanded", "true");
      document.documentElement.classList.add("m-lock");
      // 同帧聚焦（不延时）：iOS 要求 focus 发生在用户手势内
      if (focusSearch) {
        var input = sheet.querySelector("input");
        if (input) input.focus({ preventScroll: true });
      }
    }
    function mClose() {
      var sheet = document.getElementById("m-sheet");
      var bar = document.querySelector(".m-bar");
      if (sheet) sheet.classList.remove("open");
      if (bar) {
        bar.classList.remove("m-open");
        var menuBtn = bar.querySelector(".m-btn-menu");
        if (menuBtn) menuBtn.setAttribute("aria-expanded", "false");
      }
      document.documentElement.classList.remove("m-lock");
    }
    window.__mOpen = mOpen;
    window.__mClose = mClose;

    function initMobileHeader() {
      var bar = document.querySelector(".m-bar");
      var sheet = document.getElementById("m-sheet");
      if (!bar || !sheet || bar.__mBound) return;
      bar.__mBound = true;
      // 防御：换页后不应残留滚动锁
      document.documentElement.classList.remove("m-lock");

      var menuBtn = bar.querySelector(".m-btn-menu");
      if (menuBtn)
        menuBtn.addEventListener("click", function () {
          sheet.classList.contains("open") ? mClose() : mOpen(false);
        });
      var searchBtn = bar.querySelector(".m-btn-search");
      if (searchBtn)
        searchBtn.addEventListener("click", function () {
          mOpen(true);
        });
      var scrim = sheet.querySelector(".m-scrim");
      if (scrim) scrim.addEventListener("click", mClose);
      // 点击面板内任意链接：先收起再导航
      sheet.querySelectorAll(".m-panel a").forEach(function (a) {
        a.addEventListener("click", mClose);
      });

      // 主题快捷切换（与 PC 设置面板的 ThemeToggle 共用 localStorage: theme）
      var themeBtn = bar.querySelector(".m-btn-theme");
      if (themeBtn)
        themeBtn.addEventListener("click", function () {
          var html = document.documentElement;
          var next = !html.classList.contains("dark");
          html.classList.toggle("dark", next);
          localStorage.setItem("theme", next ? "dark" : "light");
        });
    }
    initMobileHeader();
    if (!window.__mPageLoadBound) {
      window.__mPageLoadBound = true;
      document.addEventListener("astro:page-load", initMobileHeader);
    }

    // 滚动隐藏：下滚收起顶栏，上滚/回顶恢复；菜单展开期间不动
    if (!window.__mScrollBound) {
      window.__mScrollBound = true;
      var lastY = window.scrollY;
      var ticking = false;
      window.addEventListener(
        "scroll",
        function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () {
            ticking = false;
            var bar = document.querySelector(".m-bar");
            var sheet = document.getElementById("m-sheet");
            if (!bar) return;
            var y = window.scrollY;
            if (sheet && sheet.classList.contains("open")) {
              lastY = y;
              return;
            }
            if (y > lastY && y > 80) bar.classList.add("m-hide");
            else if (y < lastY - 2 || y <= 80) bar.classList.remove("m-hide");
            lastY = y;
          });
        },
        { passive: true },
      );
    }

    // Escape 关闭菜单
    if (!window.__mKeyBound) {
      window.__mKeyBound = true;
      document.addEventListener("keydown", function (e) {
        if (e.key !== "Escape") return;
        var sheet = document.getElementById("m-sheet");
        if (sheet && sheet.classList.contains("open")) mClose();
      });
    }
  })();
</script>


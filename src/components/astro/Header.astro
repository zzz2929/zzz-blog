<style is:global>
  /* 移动端全屏菜单展开时锁页面滚动（放媒体查询内：旋屏跨断点时自动失效/恢复） */
  @media (max-width: 1023px) {
    html.m-lock {
      overflow: hidden;
    }
  }

  /* ===== Header 内联搜索(输入即搜,结果下拉) ===== */
  .header-search-box {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 12px;

</style>

<script>
    import { loadPagefind } from "@/lib/pagefind";

    let pagefind: any = null;
    let timer = 0;

    async function run(input: HTMLInputElement, panel: HTMLElement) {
      const q = input.value.trim();
      panel.innerHTML = "";
      if (!q) {
        panel.classList.remove("open");
        return;
      }
      try {
        pagefind ??= await loadPagefind();
        const res = await pagefind.search(q, {
          locales: [document.documentElement.lang.toLowerCase()],
        });
        if (!res.results.length) {
          panel.textContent = panel.dataset.empty || "";
          panel.classList.add("open");
          return;
        }
        const data = await Promise.all(
          res.results.slice(0, 8).map((r) => r.data()),
        );
        for (const d of data) {
          const a = document.createElement("a");
          a.href = d.url;
          a.className = "header-search-item";
          const title = document.createElement("div");
          title.className = "hs-title";
          title.textContent = d.meta?.title || d.url;
          const excerpt = document.createElement("p");
          excerpt.className = "hs-excerpt";
          excerpt.innerHTML = d.excerpt || "";
          a.append(title, excerpt);
          panel.appendChild(a);
        }
        panel.classList.add("open");
      } catch {
        // dev 下无索引等场景
        panel.textContent = panel.dataset.noIndex || "";
        panel.classList.add("open");
      }
    }

    function initHeaderSearch() {
      // PC 内联框与移动端面板各有一个 .header-search 容器，逐个绑定
      document.querySelectorAll(".header-search").forEach((container) => {
        const input = container.querySelector<HTMLInputElement>("input");
        const panel = container.querySelector<HTMLElement>(".header-search-panel");
        if (!input || !panel || (input as any).__hsBound) return;
        (input as any).__hsBound = true;

        input.addEventListener("input", () => {
          clearTimeout(timer);
          timer = setTimeout(() => run(input, panel), 200);
        });
        input.addEventListener("focus", () => {
          if (input.value.trim() && panel.children.length) panel.classList.add("open");
        });
        input.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            panel.classList.remove("open");
            input.blur();
          }
        });
      });
    }

    // 外部点击收起(委托一次;面板在 View Transitions 换页后是 DOM 里的新元素)
    if (!(window as any).__headerSearchDocBound) {
      (window as any).__headerSearchDocBound = true;
      document.addEventListener("click", (e) => {
        const t = e.target as Node;
        document.querySelectorAll(".header-search").forEach((container) => {
          const panel = container.querySelector(".header-search-panel");
          if (panel && !container.contains(t)) panel.classList.remove("open");
        });
      });
    }

    initHeaderSearch();
    // astro:page-load 首次加载与每次换页都会触发
    document.addEventListener("astro:page-load", initHeaderSearch);
  </script>

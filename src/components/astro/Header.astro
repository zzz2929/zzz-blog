    transform: scale(1.2);
    pointer-events: none;
    transition: 500ms cubic-bezier(0.175, 0.885, 0.32, 1.1);
  }
  .item-color::before {
    position: absolute;
    content: attr(aria-color);
    left: 65%;
    /* 父级 hover scale(1.5) 会把 tooltip 一并放大抬高：
       41px 定位 + scale(0.6667) 反向缩放，文字保持原始大小；
       实测（510 视口）：悬停时 tooltip 顶缘距「切换背景色」标题底约 3.5px、
       底缘在放大色块顶上方约 1.5px（与下方 .container-items 的 padding-top:26px 联动） */
    bottom: 41px;
    transform: translateX(-50%) scale(0.6667);
    transform-origin: 50% 100%;
    z-index: 2;
    padding: 2px 8px;
    font-size: 10px;
    line-height: 14px;
    white-space: nowrap;
    color: var(--color-foreground);
    background-color: #ffffff;
    border-radius: 6px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: 500ms cubic-bezier(0.175, 0.885, 0.32, 1.1);
  }
  .dark .item-color::before {
    color: #eee;
    background-color: rgba(30, 30, 40, 0.95);
  }
  .item-color:hover {
    transform: scale(1.5);
    z-index: 99999;
  }
  .item-color:hover::before {
    opacity: 1;
    visibility: visible;
  }
  .item-color:active::after {
    transform: scale(1.1);
  }
  /* 设置面板：宽度与视口保护放在样式表里（内联 calc 在个别加载瞬间会算出 0，
     导致面板塌缩只剩文字浮在页面上） */
  .settings-dropdown {
    width: 320px;
    max-width: calc(100vw - 32px);
  }
  .settings-dropdown .container-items {
    max-width: 100%;
    /* tooltip（::before）与色块的纵向间隙由 padding-top 预留，须与 ::before 的
       bottom:41px 联动下调（原 50px/53px 组合使色块距「切换背景色」标题 57px 过远）；
       26px 时实测色块距标题 33px，悬停提示条仍不遮标题 */
    padding-top: 26px;
  }
  /* 点击展开的强制显示样式仅在无 hover 的触屏设备生效；
     桌面 hover 设备上 touch-open 无视觉效果，仍由 group-hover 接管 */
  @media (hover: none) {
    .settings-dropdown.touch-open,
    .site-switcher-dropdown.touch-open {
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }
    .site-switcher-dropdown.touch-open {
      transform: translateY(0) !important;
    }
  }

  .item-color.selected {
    /* 蓝框不被悬停邻块的放大色块盖住；仍低于悬停块本身（99999） */
    z-index: 99998;
  }
  .item-color.selected::after {
    box-shadow: 0 0 0 2px var(--color-primary);
  }
  .item-color:hover + * {
    transform: scale(1.3);
    z-index: 9999;
  }
  .item-color:hover + * + * {
    transform: scale(1.15);
    z-index: 999;
  }
  .item-color:has(+ *:hover) {
    transform: scale(1.3);
    z-index: 9999;
  }
  .item-color:has(+ * + *:hover) {
    transform: scale(1.15);
    z-index: 999;
  }

  /* ===== 自定义右键菜单 / 鼠标特效开关（switch） ===== */
  .custom-ui-switch {
    width: 40px;
    height: 22px;
    border-radius: 999px;
    position: relative;
    background: rgba(0, 0, 0, 0.15);

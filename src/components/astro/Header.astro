---
import ThemeToggle from "@/components/react/ThemeToggle.tsx";
import { useTranslations, getLocaleFromURL } from "@/i18n";
import type { Locale } from "@/i18n";

// Navigation SVGs inlined at build time (virtual module from astro.config.mjs)
import iconMap from 'virtual:nav-svgs';

const locale = getLocaleFromURL(Astro.url.pathname) as Locale;
const t = useTranslations(locale);
const prefix = locale === "zh-CN" ? "" : `/${locale}`;

// Keep the current page when switching languages: strip the active locale
// prefix to get the canonical (zh-CN) path, then re-add the target prefix.
const basePath =
  prefix && Astro.url.pathname.startsWith(prefix)
    ? Astro.url.pathname.slice(prefix.length) || "/"
    : Astro.url.pathname;
const switchLocaleHref = (target: Locale) =>
  target === "zh-CN" ? basePath : `/${target}${basePath}`;

const menuItems = [
  {
    label: t("nav.posts"),
    children: [
      {
        name: t("nav.archive"),
        href: `${prefix}/archives/`,
        icon: "/navigation/归档.svg",
      },
      {
        name: t("nav.categories"),
        href: `${prefix}/categories/`,
        icon: "/navigation/分类.svg",
      },
    ],
  },
  {
    label: t("nav.friends"),
    children: [
      {
        name: t("nav.friendList"),
        href: `${prefix}/friends/`,
        icon: "/navigation/友链.svg",
      },
    ],
  },
  {
    label: t("nav.entertainment"),
    children: [
      {
        name: t("nav.music"),
        href: `${prefix}/music/`,
        icon: "/navigation/音乐.svg",
      },
      {
        name: t("nav.bangumis"),
        href: `${prefix}/bangumis/`,
        icon: "/navigation/追番.svg",
      },
      {
        name: t("nav.album"),
        href: `${prefix}/album/`,
        icon: "/navigation/相册.svg",
      },
    ],
  },
  {
    label: t("nav.about"),
    children: [
      {
        name: t("nav.aboutMe"),
        href: `${prefix}/about/`,
        icon: "/navigation/关于本人.svg",
      },
      {
        name: t("nav.essay"),
        href: `${prefix}/essay/`,
        icon: "/navigation/闲言碎语.svg",
      },
      {
        name: t("nav.equipment"),
        href: `${prefix}/equipment/`,
        icon: "/navigation/我的装备.svg",
      },
    ],
  },
];

const siteLinks = [
  {
    name: "博客",
    href: "https://blog.904002.xyz/",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/blog.svg",
  },
  {
    name: "图床",
    href: "https://imgbed.904002.xyz/",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/图床.svg",
  },
  {
    name: "Waline",
    href: "https://waline.904002.xyz/",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/waline.webp",
  },
  {
    name: "FnOS",
    href: "https://zxyzzz.fnos.net/",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/fnos/fnos1.svg",
  },
  {
    name: "ConvertX",
    href: "https://convertx-fn.904002.xyz/",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/ConvertX.svg",
  },
  {
    name: "Openlist",
    href: "https://openlist.904002.xyz/",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/Openlist.svg",
  },
  {
    name: "道理鱼",
    href: "https://daoliyu-fn.904002.xyz/",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/daoliyu.webp",
  },
  {
    name: "Home Assistant",
    href: "https://ha-fn.904002.xyz/",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/Homeassistant.svg",
  },
  {
    name: "OmniTools",
    href: "https://omnitools-fn.904002.xyz/",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/OmniTools.svg",
  },
  {
    name: "AI Draw",
    href: "https://aidraw.904002.xyz/",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/aidraw.webp",
  },
  {
    name: "米家",
    href: "https://fn-mijia.904002.xyz:7999",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/米家.svg",
  },
  {
    name: "路由器",
    href: "https://fn-xiaomirouter.904002.xyz:7999",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/路由器.svg",
  },
  {
    name: "Meting-API",
    href: "https://fn-metingapi.904002.xyz:7999",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/api-music.svg",
  },
  {
    name: "飞牛音乐",
    href: "https://fn-music.904002.xyz:7999",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/飞牛音乐.webp",
  },
  {
    name: "Media Go",
    href: "https://fn-mediago.904002.xyz:7999",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/Media_Go.webp",
  },
  {
    name: "easy_cover",
    href: "https://cover.904002.xyz/",
    icon: "https://imgbed.904002.xyz/file/img/blog/icon/easy_cover.svg",
  },
];

function isImageIcon(icon) {
  return (
    icon.startsWith("http") ||
    icon.startsWith("/") ||
    icon.endsWith(".svg") ||
    icon.endsWith(".png") ||
    icon.endsWith(".jpg") ||
    icon.endsWith(".jpeg") ||
    icon.endsWith(".gif") ||
    icon.endsWith(".webp")
  );
}
---

<header
  class="site-header fixed left-0 right-0 transition-all duration-300"
  id="site-header"
  style="top: 10px; padding: 0 16px; z-index: 9999;"
>
  <div class="mx-auto" style="max-width: 1318px;">
    <div
      class="header-bar flex items-center justify-between px-4 sm:px-6 rounded-full glass-card-strong"
      style="height: var(--header-height); box-shadow: 0 1px 24px rgba(0,0,0,0.1); overflow: visible !important"
    >
      <div class="flex items-center gap-1 shrink-0">
        <!-- Site switcher -->
        <div class="site-switcher relative group">
          <button
            class="switcher-btn flex items-center justify-center rounded-xl transition-all duration-300 glass-card-strong"
            aria-label={t("nav.siteNav")}
            style="width: 38px; height: 38px; color: var(--color-foreground-muted)"
          >
            <svg
              class="transition-transform duration-300"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <circle cx="5" cy="12" r="1.5"></circle><circle
                cx="12"
                cy="12"
                r="1.5"></circle><circle cx="19" cy="12" r="1.5"></circle>
            </svg>
          </button>
          <div
            class="site-switcher-dropdown absolute left-0 top-full mt-2 p-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 glass-card-strong"
            style="z-index: 99999; width: max-content; max-width: calc(100vw - 32px); border-radius: 14px; box-shadow: 0 8px 32px rgba(0,0,0,0.12)"
          >
            <div class="grid grid-cols-[repeat(2,auto)] gap-1">
              {
                siteLinks.map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 px-3 py-2.5 rounded-lg whitespace-nowrap transition-all duration-200 hover:bg-foreground/5"
                    style="font-size: 16px; font-weight: 700; color: var(--color-foreground);"
                  >
                    {isImageIcon(link.icon) ? (
                      <img
                        src={link.icon}
                        alt={link.name}
                        style="width: 20px; height: 20px; object-fit: contain;"
                      />
                    ) : (
                      <span class="text-base">{link.icon}</span>
                    )}
                    <span>{link.name}</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Logo -->
        <a
          href={`${prefix}/`}
          class="logo-box group relative ml-1 flex items-center overflow-hidden rounded-xl cursor-pointer glass-card-strong"
          aria-label={t("nav.home")}
          style="width: 112px; height: 38px; transition: border-color 0.5s ease-in-out, box-shadow 0.5s ease-in-out"
        >
          <span
            class="logo-icon absolute inset-y-0 left-0 z-10 flex items-center justify-center transition-all duration-500 ease-in-out"
            style="width: 38px;"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="color: #425aef; transition: transform 0.5s ease, stroke 0.5s ease;"
            >
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
          </span>
          <span
            class="logo-text relative z-10 flex h-full w-full items-center text-sm font-bold whitespace-nowrap overflow-hidden transition-all duration-500 ease-in-out"
            style="color: #425aef; padding-left: 44px; padding-right: 10px;"
          >
            zzz-blog
          </span>
        </a>
      </div>

      <!-- Center nav -->
      <nav
        class="hidden md:flex items-center gap-0.5"
        style="position: absolute; left: 50%; transform: translateX(-50%);"
      >
        {
          menuItems.map((item) => (
            <div class="nav-item relative">
              <button
                class="nav-trigger flex items-center gap-1 rounded-lg px-3 py-2 transition-colors"
                style="font-size: 16px; font-weight: 700; color: var(--color-foreground);"
              >
                {item.label}
                <svg
                  class="h-3 w-3 transition-transform duration-200 nav-arrow"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </button>
              <div
                class="nav-dropdown absolute top-full"
                style="z-index: 99999; left: 50%; transform: translateX(-50%) translateY(8px); opacity: 0; visibility: hidden; pointer-events: none; background: linear-gradient(135deg, rgba(255,255,255,0.75), rgba(255,255,255,0.45)); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid rgba(255,255,255,0.35); border-radius: 16px; box-shadow: 0 12px 40px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.06); padding: 6px; white-space: nowrap; transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;"
              >
                <div class="nav-dropdown-inner flex items-center gap-0.5">
                  {item.children.map((child, ci) => (
                    <a
                      href={child.href}
                      class="nav-dropdown-item flex items-center gap-2.5 rounded-[10px] px-3 py-2 whitespace-nowrap transition-all duration-200"
                      style={`font-size: 15px; font-weight: 600; color: var(--color-foreground); opacity: 0; transform: translateY(6px); transition-delay: ${ci * 30}ms;`}
                    >
                      {iconMap[child.icon] ? (
                        <Fragment set:html={iconMap[child.icon].replace(/width="[^"]*"/, 'width="18"').replace(/height="[^"]*"/, 'height="18"')} />
                      ) : isImageIcon(child.icon) ? (
                        <img
                          src={child.icon}
                          alt={child.name}
                          style="width: 18px; height: 18px; display: block; flex-shrink: 0;"
                        />
                      ) : (
                        <span class="text-base">{child.icon}</span>
                      )}
                      <span>{child.name}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </nav>

      <!-- Right side -->
      <div class="flex items-center gap-1.5 shrink-0">
        <!-- Settings -->
        <div class="settings-menu relative group">
          <button
            class="settings-btn glass-card-strong"
            aria-label={t("nav.settings")}
            title={t("nav.settings")}
            style="display: flex; justify-content: center; align-items: center; padding: 6px 12px; gap: 8px; height: 36px; border-radius: 20px; cursor: pointer; transition: all 0.3s ease"
          >
            <svg
              class="settings-icon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#425aef"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              style="transition: transform 0.3s ease;"
            >
              <circle cx="12" cy="12" r="3"></circle>
              <path
                d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06A1.65 1.65 0 0019.32 9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"
              ></path>
            </svg>
            <span
              style="line-height: 20px; font-size: 14px; color: #425aef; font-family: sans-serif; letter-spacing: 1px;"
              >{t("nav.settings")}</span
            >
          </button>
          <div
            class="settings-dropdown absolute right-0 top-full mt-2 p-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 glass-card-strong"
            style="z-index: 99999; border-radius: 14px; box-shadow: 0 8px 32px rgba(0,0,0,0.12)"
          >
            <div class="flex items-center justify-between mb-3">
              <span
                style="font-size: 16px; font-weight: 700; color: var(--color-foreground);"
                >{t("nav.darkMode")}</span
              >
              <ThemeToggle client:only="react" locale={locale} />
            </div>
            <div
              style="height: 1px; background: var(--color-border); margin-bottom: 12px;"
            >
            </div>
            <!-- Monet palette selector -->
            <div class="mb-3">
              <span
                class="block mb-2"
                style="font-size: 16px; font-weight: 700; color: var(--color-foreground);"
                >{t("nav.bgColor")}</span
              >
              <div id="monet-palette-grid" class="container-items">
                <button
                  class="item-color"
                  data-color="var(--monet-1)"
                  aria-color="云端漫步"
                  title="云端漫步"
                  style="--color: var(--monet-1);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-2)"
                  aria-color="睡莲"
                  title="睡莲"
                  style="--color: var(--monet-2);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-3)"
                  aria-color="日出印象"
                  title="日出印象"
                  style="--color: var(--monet-3);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-4)"
                  aria-color="干草堆"
                  title="干草堆"
                  style="--color: var(--monet-4);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-5)"
                  aria-color="紫藤"
                  title="紫藤"
                  style="--color: var(--monet-5);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-6)"
                  aria-color="鲁昂大教堂"
                  title="鲁昂大教堂"
                  style="--color: var(--monet-6);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-7)"
                  aria-color="塞纳河"
                  title="塞纳河"
                  style="--color: var(--monet-7);"></button>
                <button
                  class="item-color"
                  data-color="var(--monet-8)"
                  aria-color="纯白"
                  title="纯白"
                  style="--color: var(--monet-8);"></button>
              </div>
            </div>
            <div
              style="height: 1px; background: var(--color-border); margin-bottom: 12px;"
            >
            </div>
            <div class="flex items-center justify-between">
              <span
                style="font-size: 16px; font-weight: 700; color: var(--color-foreground);"
                >{t("nav.langSwitch")}</span
              >
              <div class="flex gap-1">
                <a
                  href={switchLocaleHref("zh-CN")}
                  class:list={[
                    "px-2 py-1 rounded text-xs font-medium transition-colors",
                    locale === "zh-CN"
                      ? "bg-[var(--color-primary)] text-white"
                      : "",
                  ]}
                  style={locale !== "zh-CN"
                    ? "border: 1px solid var(--color-border); color: var(--color-foreground-muted);"
                    : ""}>简</a
                >
                <a
                  href={switchLocaleHref("zh-TW")}
                  class:list={[
                    "px-2 py-1 rounded text-xs font-medium transition-colors",
                    locale === "zh-TW"
                      ? "bg-[var(--color-primary)] text-white"
                      : "",
                  ]}
                  style={locale !== "zh-TW"
                    ? "border: 1px solid var(--color-border); color: var(--color-foreground-muted);"
                    : ""}>繁</a
                >
                <a
                  href={switchLocaleHref("en")}
                  class:list={[
                    "px-2 py-1 rounded text-xs font-medium transition-colors",
                    locale === "en"
                      ? "bg-[var(--color-primary)] text-white"
                      : "",
                  ]}
                  style={locale !== "en"
                    ? "border: 1px solid var(--color-border); color: var(--color-foreground-muted);"
                    : ""}>En</a
                >
              </div>
            </div>
          </div>
        </div>

        <button
          id="mobile-menu-btn"
          class="p-2 rounded-lg transition-colors md:hidden"
          style="color: var(--color-foreground-muted);"
          aria-label={t("nav.menu")}
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"></path></svg
          >
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden mx-auto"
    style="max-width: var(--content-max-width); margin-top: 8px;"
  >
    <div
      class="px-4 py-3 rounded-2xl space-y-1 glass-card-strong"
      style="box-shadow: 0 8px 32px rgba(0,0,0,0.12)"
    >
      {
        menuItems.map((item) => (
          <div class="mb-2">
            <div
              class="px-3 py-2 text-xs font-semibold uppercase tracking-wider"
              style="color: var(--color-foreground-muted);"
            >
              {item.label}
            </div>
            <div class="flex flex-wrap gap-2 px-2">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm transition-all duration-200 hover:bg-foreground/5"
                  style="color: var(--color-foreground); border: 1px solid var(--color-border);"
                >
                  {iconMap[child.icon] ? (
                    <Fragment set:html={iconMap[child.icon].replace(/width="[^"]*"/, 'width="16"').replace(/height="[^"]*"/, 'height="16"')} />
                  ) : isImageIcon(child.icon) ? (
                    <img
                      src={child.icon}
                      alt={child.name}
                      style="width: 16px; height: 16px; object-fit: contain;"
                    />
                  ) : (
                    <span>{child.icon}</span>
                  )}
                  {child.name}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</header>

<!-- Spacer for fixed header (header is offset 10px from top) -->
<div style="height: calc(var(--header-height) + 10px);"></div>

<script is:inline>
  // 汉堡菜单：展开时收起设置/站点切换的下拉，避免重叠
  document.getElementById("mobile-menu-btn")?.addEventListener("click", () => {
    const mobileMenu = document.getElementById("mobile-menu");
    const opening = mobileMenu?.classList.contains("hidden");
    mobileMenu?.classList.toggle("hidden");
    if (opening) {
      document
        .querySelector(".settings-dropdown")
        ?.classList.remove("touch-open");
      document
        .querySelector(".site-switcher-dropdown")
        ?.classList.remove("touch-open");
    }
  });

  // 设置 / 站点切换：点击展开，三者互斥，点外部收起。
  // touch-open 的显示样式只在无 hover 的触屏设备生效（见样式表），
  // 桌面 hover 设备上点击添加的类无视觉效果，仍由 group-hover 接管。
  (function () {
    const mobileMenu = document.getElementById("mobile-menu");
    const menus = [
      {
        menu: document.querySelector(".settings-menu"),
        btn: document.querySelector(".settings-btn"),
        dropdown: document.querySelector(".settings-dropdown"),
      },
      {
        menu: document.querySelector(".site-switcher"),
        btn: document.querySelector(".switcher-btn"),
        dropdown: document.querySelector(".site-switcher-dropdown"),
      },
    ];
    menus.forEach(({ menu, btn, dropdown }) => {
      if (!menu || !btn || !dropdown) return;
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const opening = !dropdown.classList.contains("touch-open");
        // 互斥：关闭其他下拉面板
        menus.forEach((other) => {
          if (other.dropdown !== dropdown)
            other.dropdown.classList.remove("touch-open");
        });
        dropdown.classList.toggle("touch-open");
        // 展开下拉时收起汉堡菜单
        if (opening) mobileMenu?.classList.add("hidden");
      });
      document.addEventListener("click", (e) => {
        if (!menu.contains(e.target))
          dropdown.classList.remove("touch-open");
      });
    });
  })();

  // Scroll effect: shrink shadow on scroll
  (function () {
    const h = document.getElementById("site-header");
    if (!h) return;
    let t = false;
    window.addEventListener(
      "scroll",
      () => {
        if (!t) {
          requestAnimationFrame(() => {
            const inner = h.querySelector(":scope > div > div");
            if (inner) {
              inner.style.boxShadow =
                window.scrollY > 20
                  ? "0 4px 20px rgba(0,0,0,0.1)"
                  : "0 2px 12px rgba(0,0,0,0.06)";
            }
            t = false;
          });
          t = true;
        }
      },
      { passive: true },
    );
  })();

  // Monet palette switcher (light mode only)
  (function () {
    const swatches = document.querySelectorAll(".item-color");
    const paletteGrid = document.getElementById("monet-palette-grid");
    let stored = localStorage.getItem("monet-bg") || "var(--monet-1)";

    function isDark() {
      return document.documentElement.classList.contains("dark");
    }

    // swatch 传的是 var(--monet-N)，计算边框色时需要解析成实际 hex
    function resolveColor(color) {
      if (!color.startsWith("var(")) return color;
      return (
        getComputedStyle(document.documentElement)
          .getPropertyValue(color.slice(4, -1).trim())
          .trim() || "#EDE8DE"
      );
    }

    function applyPalette(color) {
      stored = color; // 同步闭包状态，深色模式切换回切时才能恢复用户选的颜色
      if (isDark()) {
        // Dark mode: remove inline background, let CSS starfield take over
        document.body.style.background = "";
        document.documentElement.style.setProperty(
          "--color-border",
          "rgba(255,255,255,0.08)",
        );
        if (paletteGrid) paletteGrid.style.opacity = "0.4";
        swatches.forEach((s) => {
          s.style.pointerEvents = "none";
        });
        return;
      }
      // Light mode: apply Monet palette
      if (paletteGrid) paletteGrid.style.opacity = "1";
      swatches.forEach((s) => {
        s.style.pointerEvents = "auto";
      });
      document.body.style.background = color;
      localStorage.setItem("monet-bg", color);
      // Match border color
      const hex = resolveColor(color);
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      document.documentElement.style.setProperty(
        "--color-border",
        `rgb(${Math.max(0, r - 15)}, ${Math.max(0, g - 15)}, ${Math.max(0, b - 15)})`,
      );
      swatches.forEach((s) => {
        s.classList.toggle("selected", s.dataset.color === color);
      });
    }

    // Init
    applyPalette(stored);

    swatches.forEach((swatch) => {
      swatch.addEventListener("click", () => {
        if (isDark()) return;
        applyPalette(swatch.dataset.color);
      });
    });

    // Listen for dark mode toggle changes
    const observer = new MutationObserver(() => applyPalette(stored));
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  })();
</script>


---
import { useTranslations, getLocaleFromURL } from '@/i18n';

interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { headings } = Astro.props;

const locale = getLocaleFromURL(Astro.url.pathname);
const t = useTranslations(locale);

// H1 is the page title (rendered separately), start from H2
const filteredHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 6);
---

{
  filteredHeadings.length > 0 && (
    <nav
      class="toc glass-card"
      style="border-radius: 16px; box-shadow: 0 1px 24px rgba(0,0,0,0.1); padding: 20px;"
    >
      <h4 class="mb-3 text-sm font-semibold text-foreground flex items-center gap-2">
        <span
          class="inline-block w-1 h-5 rounded-full"
          style="background: linear-gradient(180deg, var(--color-primary), var(--color-accent));"
        />
        {t('post.toc')}
      </h4>

      <div
        class="toc-list-wrap"
        style="overflow-y: auto; max-height: calc(100vh - 110px);"
      >
        <div id="toc" />
      </div>
    </nav>
  )
}

<style is:global>
  /* tocbot 生成的目录结构样式（客户端渲染，无 scoped 属性，需全局选择器） */
  #toc .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #toc .toc-list ol {
    list-style: none;
    margin: 0;
    padding-left: 14px;
  }
  #toc a.toc-link {
    position: relative;
    display: block;
    padding: 2px 0 2px 16px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-foreground-muted);
    transition: color 0.3s ease;
  }
  #toc a.toc-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 0;
    background: linear-gradient(180deg, var(--color-primary), var(--color-accent));
    border-radius: 2px;
    transition: height 0.3s ease;
  }
  #toc a.toc-link:hover::before,
  #toc a.toc-link.is-active-link::before {
    height: 100%;
  }
  #toc a.toc-link.node-name--H3 {
    font-size: 13px;
    font-weight: 600;
  }
  #toc a.toc-link.node-name--H4 {
    font-size: 12px;
    font-weight: 500;
  }
  #toc a.toc-link.node-name--H5,
  #toc a.toc-link.node-name--H6 {
    font-size: 11px;
    font-weight: 400;
  }
  #toc a.toc-link:hover,
  #toc a.toc-link.is-active-link {
    color: var(--color-primary);
    font-weight: 700;
  }
</style>

<script>
  import tocbot from 'tocbot';

  // 目录较长时，让当前激活项保持可见
  function keepActiveInView() {
    const wrap = document.querySelector('.toc-list-wrap');
    const active = document.querySelector('#toc a.is-active-link');
    if (!wrap || !active) return;
    const top =
      active.getBoundingClientRect().top -
      wrap.getBoundingClientRect().top +
      wrap.scrollTop;
    if (
      top < wrap.scrollTop ||
      top + active.offsetHeight > wrap.scrollTop + wrap.clientHeight
    ) {
      wrap.scrollTo({
        top: top - wrap.clientHeight / 2 + active.offsetHeight / 2,
        behavior: 'smooth',
      });
    }
  }

  function initToc() {
    tocbot.destroy();
    if (!document.getElementById('toc')) return;
    tocbot.init({
      tocSelector: '#toc',
      contentSelector: '.prose',
      headingSelector: 'h2, h3, h4, h5, h6',
      headingsOffset: 90,
      scrollSmooth: true,
      scrollSmoothDuration: 300,
      collapseDepth: 6,
      scrollEndCallback: keepActiveInView,
    });
  }

  initToc();
  document.addEventListener('astro:page-load', initToc);
  // 图片懒加载会改变文档高度，加载完成后刷新标题位置
  window.addEventListener('load', () => tocbot.refresh());
</script>

---
import { useTranslations, getLocaleFromURL } from '@/i18n';

interface Props {
  item: Record<string, any>;
  /** 图片宽度策略： "auto" 由外层适配，"100%" 撑满卡片 */
  imgWidth?: string;
  class?: string;
  borderColor?: string;
}

const { item, imgWidth = 'auto', class: className = '', borderColor } = Astro.props;
const locale = getLocaleFromURL(Astro.url.pathname);
const t = useTranslations(locale);
---

<div
  class:list={["essay-card rounded-xl p-4 glass-card", className]}
  style={`box-shadow: 0 1px 24px rgba(0,0,0,0.1);${borderColor ? ` border-color: ${borderColor};` : ""}`}
>
  {
    item.img && item.img.length > 0 && (
      <div class="flex flex-wrap items-center justify-center gap-2">
        {item.img.map((src: string) => (
          <img
            src={src}
            alt=""
            loading="lazy"
            decoding="async"
            class="essay-img rounded-lg"
            style={`width: ${imgWidth}; max-width: 100%; max-height: 420px; object-fit: contain;`}
          />
        ))}
      </div>
    )
  }
  <p class:list={["text-center text-foreground whitespace-pre-line", { "mt-3": item.img && item.img.length > 0 }]}>{item.content}</p>
  {
    item.video?.map((url: string) => (
      <div class="mt-3 aspect-video overflow-hidden rounded-lg">
        <iframe src={url} class="h-full w-full" allowfullscreen loading="lazy" />
      </div>
    ))
  }
  {
    item.link && (
      <a
        href={item.link}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-block text-sm text-primary hover:underline"
      >
        {t('essay.viewLink')}
      </a>
    )
  }
</div>

<style>
  /* 悬停浮起：轻微放大 + 投影；hover 时置顶，避免放大边缘被相邻图片盖住 */
  .essay-img {
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .essay-img:hover {
    z-index: 1;
    transform: scale(1.04);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.2);
  }
</style>

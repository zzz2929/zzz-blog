---
import { useTranslations, getLocaleFromURL } from '@/i18n';
import { siteConfig } from '@/config/site';

const commentConfig = siteConfig.features.comments;

// 评论区在 src/config/site.ts（features.comments.enable）中统一开关
if (!commentConfig.enable) return null;

const locale = getLocaleFromURL(Astro.url.pathname);
const t = useTranslations(locale);

const walineLangMap: Record<string, string> = {
  'zh-CN': 'zh-CN',
  'en': 'en',
  'zh-TW': 'zh-TW',
};
const walineLang = walineLangMap[locale] || 'zh-CN';

// 传给客户端脚本的 Waline 初始化参数（全部来自 src/config/site.ts → features.comments）
const walineOptions = JSON.stringify({
  serverURL: commentConfig.serverURL,
  emoji: commentConfig.emoji,
  meta: commentConfig.meta,
  requiredMeta: commentConfig.requiredMeta,
  login: commentConfig.login,
  wordLimit: commentConfig.wordLimit,
  pageSize: commentConfig.pageSize,
  commentSorting: commentConfig.commentSorting,
  placeholder: commentConfig.placeholder,
  dark: commentConfig.dark,
  imageUploader: commentConfig.imageUploader,
  highlighter: commentConfig.highlighter,
  search: commentConfig.search,
  reaction: commentConfig.reaction,
  comment: commentConfig.comment,
  pageview: commentConfig.pageview,
  math: commentConfig.math,
  visitor: commentConfig.visitor,
  sortBy: commentConfig.sortBy,
  noRss: commentConfig.noRss,
});
---

<link
  rel="stylesheet"
  href="https://unpkg.com/@waline/client@v3/dist/waline.css"
/>
<div
  id="waline"
  class="mt-5 glass-card"
  data-waline-lang={walineLang}
  data-waline-placeholder={t('comment.placeholder')}
  data-waline-options={walineOptions}
  style="border-radius: 16px; box-shadow: 0 1px 24px rgba(0,0,0,0.1); padding: 16px 20px"
>
</div>
<script type="module">
  import { init } from "https://unpkg.com/@waline/client@v3/dist/waline.js";

  const el = document.getElementById("waline");
  const options = JSON.parse(el?.dataset.walineOptions || "{}");
  init({
    el: "#waline",
    path: window.location.pathname.replace(/\/$/, ""),
    lang: el?.dataset.walineLang ?? "zh-CN",
    ...options,
    placeholder: el?.dataset.walinePlaceholder ?? options.placeholder,
  });
</script>
